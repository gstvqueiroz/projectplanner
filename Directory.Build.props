<Project>
  <!-- Metadados comuns a todos os projetos. <Version> é a versão do produto, num lugar só: MAJOR.MINOR.PATCH,
       com MINOR igual ao número do bloco (Bloco 15 = 0.15.0) e PATCH para ajustes dentro do bloco (0.15.1). Ela vai para o título da janela
       (VersaoDoProduto), para o .exe do Windows, para o instalador, para o Info.plist do .app e para o
       nome dos .zip; o scripts/publicar.sh pede para confirmá-la antes de publicar (ver PUBLISHING.md). -->
  <PropertyGroup>
    <Version>0.40.0</Version>
    <Product>ProjectPlanner</Product>
    <Authors>gustavodossantosqueiroz</Authors>
    <Company>gustavodossantosqueiroz</Company>
    <Copyright>© 2026 gustavodossantosqueiroz</Copyright>
  </PropertyGroup>
</Project>
