<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- O executável se chama ProjectPlanner(.exe); versão, autor e produto vêm do Directory.Build.props. -->
    <AssemblyName>ProjectPlanner</AssemblyName>
    <AssemblyTitle>ProjectPlanner</AssemblyTitle>
    <Description>Planejamento de projetos com cronograma, caminho crítico e gráfico de Gantt.</Description>
    <ApplicationIcon>Assets\ProjectPlanner.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- As novidades da tela Sobre vêm do CHANGELOG.md da raiz (Bloco 25). -->
    <EmbeddedResource Include="..\..\CHANGELOG.md" LogicalName="ProjectPlanner.App.CHANGELOG.md" Link="CHANGELOG.md" />
    <InternalsVisibleTo Include="ProjectPlanner.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
  </ItemGroup>

  <!-- Na publicação (ver PUBLISHING.md), só o que o usuário precisa: sem símbolos de depuração (.pdb),
       nem os do Core/Data nem os nativos que vêm nos pacotes do SkiaSharp. -->
  <Target Name="RemoverSimbolosDaPublicacao" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\ProjectPlanner.Core\ProjectPlanner.Core.csproj" />
    <ProjectReference Include="..\ProjectPlanner.Data\ProjectPlanner.Data.csproj" />
    <ProjectReference Include="..\ProjectPlanner.IA\ProjectPlanner.IA.csproj" />
    <ProjectReference Include="..\ProjectPlanner.Imagens\ProjectPlanner.Imagens.csproj" />
  </ItemGroup>
</Project>
