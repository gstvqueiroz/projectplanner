<?xml version="1.0" encoding="utf-8"?>
<!-- macOS em Apple Silicon: self-contained em pasta, que o scripts/publicar.sh põe dentro do
     ProjectPlanner.app (o .app já é o "arquivo único" que se distribui no Mac).
     Uso: scripts/publicar.sh osx-arm64 -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <PublishDir>$(MSBuildThisFileDirectory)../../../../publicacao/osx-arm64/</PublishDir>
  </PropertyGroup>
</Project>
