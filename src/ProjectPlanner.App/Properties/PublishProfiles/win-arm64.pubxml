<?xml version="1.0" encoding="utf-8"?>
<!-- Windows (win-arm64): um único ProjectPlanner.exe self-contained (não exige .NET instalado).
     Uso: dotnet publish src/ProjectPlanner.App -p:PublishProfile=win-arm64  (ou scripts/publicar.sh win-arm64) -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-arm64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Skia, HarfBuzz e SQLite (nativas) vão dentro do .exe e são extraídas na primeira execução. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Sem trimming: o EF Core e as bindings do Avalonia usam reflexão. -->
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <PublishDir>$(MSBuildThisFileDirectory)../../../../publicacao/win-arm64/</PublishDir>
  </PropertyGroup>
</Project>
