<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ProjectPlanner.App.Views.AlteracoesPendentesWindow"
        Title="Alterações não salvas"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="20" Spacing="16" MaxWidth="420">
        <TextBlock x:Name="Pergunta" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Não salvar" Click="NaoSalvar" />
            <Button Content="Cancelar" Click="Cancelar" IsCancel="True" />
            <Button Content="Salvar" Click="Salvar" IsDefault="True" Classes="accent" />
        </StackPanel>
    </StackPanel>
</Window>
