<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ProjectPlanner.App.ViewModels"
             xmlns:v="using:ProjectPlanner.App.Views"
             xmlns:ia="using:ProjectPlanner.IA"
             x:Class="ProjectPlanner.App.Views.AssistenteView"
             x:DataType="vm:AssistenteViewModel">

    <!-- Painel do assistente de IA (Bloco 19): cabeçalho, aviso de "não configurado", conversa, anexos pendentes
         e a linha de entrada. Com uma chave configurada (Bloco 23), quem responde é o Gemini. -->
    <UserControl.Styles>
        <Style Selector="Border.balao">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="MaxWidth" Value="280" />
        </Style>
        <Style Selector="Border.anexo">
            <Setter Property="Background" Value="{DynamicResource FundoSutil}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Margin" Value="0,2,4,0" />
        </Style>
        <Style Selector="Button.plano">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,2" />
        </Style>
        <!-- Bloco 26: o balão com botões (modo, perguntas, plano) usa a largura do painel. -->
        <Style Selector="Border.balao.interativo">
            <Setter Property="MaxWidth" Value="10000" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Border.cartao">
            <Setter Property="Background" Value="{DynamicResource FundoSutil}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <!-- Respostas sugeridas: "pílulas" para clicar, uma escolhida por pergunta. -->
        <Style Selector="ListBox.opcoes">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.opcoes ListBoxItem">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="0,2,4,2" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="ListBox.opcoes ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </UserControl.Styles>

    <Border BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
        <DockPanel>
            <!-- Cabeçalho -->
            <Border DockPanel.Dock="Top" Padding="10,6" BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                <DockPanel>
                    <Button x:Name="FecharPainel" DockPanel.Dock="Right" Classes="plano" Content="×" FontSize="16"
                            Command="{Binding FecharCommand}" ToolTip.Tip="Ocultar o painel do assistente"
                            AutomationProperties.Name="Ocultar o assistente" />
                    <Button x:Name="Configurar" DockPanel.Dock="Right" Classes="plano" Content="⚙" FontSize="15"
                            Command="{Binding ConfigurarCommand}" ToolTip.Tip="Configurações do assistente (conta e nível do modelo)"
                            AutomationProperties.Name="Configurações do assistente" />
                    <Button DockPanel.Dock="Right" Classes="plano" Content="Limpar conversa" FontSize="12"
                            Command="{Binding LimparConversaCommand}" IsVisible="{Binding !ConversaVazia}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Assistente" FontWeight="SemiBold" />
                        <TextBlock x:Name="Modelo" Text="{Binding DescricaoDoModelo}" FontSize="11" Opacity="0.6"
                                   IsVisible="{Binding EstaConfigurado}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Bloco 46: o nível do modelo e o saldo de créditos do mês -->
            <Border x:Name="BarraDoNivel" DockPanel.Dock="Top" Padding="10,4" BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" IsVisible="{Binding MostrarSeletorDeNivel}">
                <StackPanel Spacing="2">
                    <DockPanel>
                        <TextBlock x:Name="Saldo" DockPanel.Dock="Right" Text="{Binding TextoDoSaldo}" FontSize="11" Opacity="0.7"
                                   VerticalAlignment="Center" Margin="8,0,0,0" ToolTip.Tip="Os créditos de IA que restam neste mês" />
                        <ComboBox x:Name="SeletorDeNivel" ItemsSource="{Binding Niveis}" SelectedItem="{Binding NivelEscolhido}"
                                  HorizontalAlignment="Stretch" FontSize="12" AutomationProperties.Name="Nível do modelo"
                                  ToolTip.Tip="Padrão para o dia a dia; Avançado e Máximo para pedidos mais difíceis (gastam mais créditos)">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:OpcaoDeNivel">
                                    <TextBlock Text="{Binding TextoCompleto}" Opacity="{Binding Opacidade}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </DockPanel>
                    <!-- Bloco 51: o modelo que o Automático escolheu para o último pedido -->
                    <TextBlock x:Name="UltimaEscolha" Text="{Binding UltimaEscolha}" FontSize="11" Opacity="0.7" TextWrapping="Wrap"
                               IsVisible="{Binding UltimaEscolha, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock x:Name="AvisoDoNivel" Text="{Binding AvisoDoNivel}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextoDeAviso}"
                               IsVisible="{Binding AvisoDoNivel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </Border>

            <!-- Sem conta: respostas simuladas. -->
            <Border x:Name="AvisoNaoConfigurado" DockPanel.Dock="Top" Background="{DynamicResource FundoDeAviso}" Padding="10,6"
                    IsVisible="{Binding !EstaConfigurado}">
                <StackPanel Spacing="2">
                    <TextBlock Text="Sem conta ProjectPlanner: respostas simuladas." FontSize="12"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextoDeAviso}" />
                    <Button x:Name="EntrarNaConta" Classes="plano" Padding="0" FontSize="12" Foreground="{DynamicResource TextoDeLink}"
                            Content="Entrar ou criar conta (grátis)…" Command="{Binding EntrarNaContaCommand}" />
                </StackPanel>
            </Border>

            <!-- Bloco 26: em que pé está o estudo, com o atalho para o plano. -->
            <Border x:Name="BarraDoEstudo" DockPanel.Dock="Top" Padding="10,4" BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" IsVisible="{Binding TemEtapaDoEstudo}">
                <DockPanel>
                    <Button x:Name="PularParaOPlano" DockPanel.Dock="Right" Classes="plano" FontSize="12" Padding="4,0"
                            Foreground="{DynamicResource TextoDeLink}" Content="Pular para o plano"
                            Command="{Binding PularParaOPlanoCommand}" IsVisible="{Binding MostrarPularParaOPlano}"
                            ToolTip.Tip="Parar as perguntas: o assistente apresenta o plano com o que já tem" />
                    <TextBlock x:Name="EtapaDoEstudo" Text="{Binding EtapaDoEstudo}" FontSize="12" Opacity="0.75"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>

            <!-- Bloco 26: a ficha do projeto, o que já foi definido; vai com cada pedido e fica no .pplan. Sempre à mão
                 (recolhida), para o usuário poder adiantar dados antes de pedir o cronograma. -->
            <Expander x:Name="FichaDoProjeto" DockPanel.Dock="Top" Header="{Binding TituloDaFicha}"
                      HorizontalAlignment="Stretch" Margin="6,4" Padding="8,4" MaxHeight="300">
                <ScrollViewer>
                    <StackPanel Spacing="4">
                        <TextBlock Text="O que já foi definido sobre a obra. O assistente preenche ao estudar; você pode corrigir."
                                   FontSize="11" Opacity="0.65" TextWrapping="Wrap" />
                        <ItemsControl x:Name="CamposDaFicha" ItemsSource="{Binding Ficha}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CampoDaFichaNaTela">
                                    <DockPanel Margin="0,1">
                                        <Button DockPanel.Dock="Right" Classes="plano" Content="×" Padding="4,0" FontSize="13"
                                                Command="{Binding $parent[UserControl].((vm:AssistenteViewModel)DataContext).RemoverCampoCommand}"
                                                CommandParameter="{Binding}" ToolTip.Tip="Tirar da ficha"
                                                AutomationProperties.Name="Tirar o campo da ficha" />
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Campo}" FontSize="12" FontWeight="SemiBold"
                                                   Width="110" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBox Text="{Binding Valor, UpdateSourceTrigger=LostFocus}" FontSize="12" MinHeight="24"
                                                 Padding="6,2" TextWrapping="Wrap" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <DockPanel Margin="0,2,0,0">
                            <Button x:Name="AdicionarCampo" DockPanel.Dock="Right" Content="+" Padding="8,2" Margin="4,0,0,0"
                                    Command="{Binding AdicionarCampoCommand}" ToolTip.Tip="Acrescentar à ficha"
                                    AutomationProperties.Name="Acrescentar o campo à ficha" />
                            <TextBox DockPanel.Dock="Left" Text="{Binding NovoCampo}" PlaceholderText="Campo" Width="110" FontSize="12"
                                     MinHeight="24" Padding="6,2" Margin="0,0,6,0" />
                            <TextBox Text="{Binding NovoValor}" PlaceholderText="Valor" FontSize="12" MinHeight="24" Padding="6,2" />
                        </DockPanel>
                        <TextBlock Text="{Binding AvisoDaFicha}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextoDeErro}"
                                   IsVisible="{Binding AvisoDaFicha, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                </ScrollViewer>
            </Expander>

            <!-- Entrada: anexar, texto (Enter envia, Shift+Enter quebra a linha) e Enviar/Cancelar. -->
            <DockPanel DockPanel.Dock="Bottom" Margin="8">
                <Button x:Name="Anexar" DockPanel.Dock="Left" Classes="plano" VerticalAlignment="Bottom" Margin="0,0,4,4"
                        Command="{Binding AnexarCommand}" ToolTip.Tip="Anexar documentos (plantas, contratos, memoriais)"
                        AutomationProperties.Name="Anexar documentos">
                    <!-- Clipe de papel -->
                    <Path Width="16" Height="16" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.4"
                          StrokeLineCap="Round"
                          Data="M11,4.5 L5.5,10 A1.8,1.8 0 0 0 8,12.5 L13,7.5 A3,3 0 0 0 8.8,3.3 L3.5,8.6 A4.2,4.2 0 0 0 9.4,14.5 L14,10" />
                </Button>
                <Panel DockPanel.Dock="Right" VerticalAlignment="Bottom" Margin="4,0,0,0">
                    <Button x:Name="Enviar" Content="Enviar" Classes="accent" Command="{Binding EnviarCommand}"
                            IsVisible="{Binding !Aguardando}" />
                    <Button x:Name="Cancelar" Content="Cancelar" Command="{Binding CancelarCommand}"
                            IsVisible="{Binding Aguardando}" />
                </Panel>
                <TextBox x:Name="Entrada" Text="{Binding TextoDigitado}" PlaceholderText="Escreva uma mensagem…"
                         AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120" MinHeight="32" />
            </DockPanel>

            <!-- Bloco 51: o aviso de custo do Automático (o envio espera a escolha) e o "Refazer com um modelo melhor". -->
            <Border x:Name="ConfirmacaoDeCusto" DockPanel.Dock="Bottom" Margin="8,4,8,0" Padding="10,8" CornerRadius="6"
                    Background="{DynamicResource FundoDeAviso}" IsVisible="{Binding TemConfirmacao}">
                <StackPanel Spacing="6" DataContext="{Binding Confirmacao}" x:DataType="vm:ConfirmacaoDeCusto">
                    <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock x:Name="EstimativaDeCusto" Text="{Binding Estimativa}" FontSize="12" TextWrapping="Wrap" />
                    <WrapPanel>
                        <Button x:Name="UsarRecomendado" Content="{Binding TextoDoRecomendado}" Classes="accent" Margin="0,0,6,4"
                                Command="{Binding $parent[UserControl].((vm:AssistenteViewModel)DataContext).UsarRecomendadoCommand}" />
                        <Button x:Name="UsarPadrao" Content="{Binding TextoDoPadrao}" Margin="0,0,6,4" IsVisible="{Binding MostrarPadrao}"
                                Command="{Binding $parent[UserControl].((vm:AssistenteViewModel)DataContext).UsarPadraoCommand}" />
                        <Button x:Name="CancelarConfirmacao" Content="Cancelar" Margin="0,0,0,4"
                                Command="{Binding $parent[UserControl].((vm:AssistenteViewModel)DataContext).CancelarConfirmacaoCommand}" />
                    </WrapPanel>
                    <CheckBox x:Name="NaoPerguntarDeNovo" IsChecked="{Binding NaoPerguntarDeNovo}" FontSize="12"
                              Content="Não perguntar de novo nesta conversa" />
                </StackPanel>
            </Border>
            <!-- Bloco 54: depois de montar um cronograma, o orçamento e os recursos da obra inteira -->
            <Button x:Name="EstimarOrcamento" DockPanel.Dock="Bottom" Classes="accent" Margin="8,4,8,0" HorizontalAlignment="Left" FontSize="12"
                    Content="{x:Static vm:AssistenteViewModel.TextoDoEstimarOrcamento}" Command="{Binding EstimarOrcamentoCommand}"
                    IsVisible="{Binding PodeEstimarOrcamento}"
                    ToolTip.Tip="Abre Projeto &gt; Orçamento com as sugestões da IA para todas as tarefas: composições da base SINAPI (se importada) ou preços estimados, quantidades e equipes. Você confere e aplica as que quiser." />
            <Button x:Name="RefazerMelhor" DockPanel.Dock="Bottom" Classes="plano" Margin="8,4,8,0" HorizontalAlignment="Left" FontSize="12"
                    Content="{Binding TextoDoRefazer}" Command="{Binding RefazerMelhorCommand}" IsVisible="{Binding PodeRefazerMelhor}"
                    ToolTip.Tip="Manda a última pergunta de novo, para um modelo mais forte (gasta mais créditos)" />

            <!-- Anexos pendentes (vão com a próxima mensagem) e aviso de anexo que falhou. -->
            <StackPanel DockPanel.Dock="Bottom" Margin="8,0" Spacing="2">
                <TextBlock Text="{Binding AvisoDeAnexo}" IsVisible="{Binding AvisoDeAnexo, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Foreground="{DynamicResource TextoDeErro}" FontSize="11" TextWrapping="Wrap" />
                <ItemsControl x:Name="Pendentes" ItemsSource="{Binding AnexosPendentes}" IsVisible="{Binding TemAnexosPendentes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="ia:AnexoIA">
                            <Border Classes="anexo">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="📎" FontSize="11" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Nome}" FontSize="12" MaxWidth="170" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" ToolTip.Tip="{Binding CaminhoLocal}" />
                                    <TextBlock Text="{Binding TamanhoLegivel}" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                                    <Button Classes="plano" Content="×" Padding="2,0" FontSize="13"
                                            Command="{Binding $parent[UserControl].((vm:AssistenteViewModel)DataContext).RemoverAnexoCommand}"
                                            CommandParameter="{Binding}" ToolTip.Tip="Tirar este anexo"
                                            AutomationProperties.Name="Tirar o anexo" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="Digitando" Text="Assistente digitando…" FontStyle="Italic" FontSize="12" Opacity="0.7"
                           IsVisible="{Binding Aguardando}" Margin="2,0" />
            </StackPanel>

            <!-- Conversa -->
            <Panel>
                <TextBlock x:Name="BoasVindas" IsVisible="{Binding ConversaVazia}" TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" Opacity="0.6"
                           Text="Peça um cronograma (por exemplo, &#x201C;monte o cronograma de uma casa térrea de 100 m²&#x201D;), peça ajustes, pergunte sobre o cronograma atual ou anexe documentos (plantas, memoriais, contratos)." />
                <ScrollViewer x:Name="Rolagem" Padding="10,6">
                    <ItemsControl x:Name="Historico" ItemsSource="{Binding Mensagens}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MensagemNaTela">
                                <Border Classes="balao"
                                        Classes.doUsuario="{Binding DoUsuario}"
                                        Classes.doAssistente="{Binding !DoUsuario}"
                                        Classes.erro="{Binding EhErro}"
                                        Classes.interativo="{Binding Interativa}">
                                    <StackPanel Spacing="3">
                                        <SelectableTextBlock Text="{Binding Texto}" TextWrapping="Wrap" FontSize="13"
                                                             IsVisible="{Binding TemTexto}" />
                                        <ItemsControl ItemsSource="{Binding Anexos}" IsVisible="{Binding TemAnexos}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="ia:AnexoIA">
                                                    <Border Classes="anexo">
                                                        <TextBlock FontSize="11" Text="{Binding Nome, StringFormat='📎 {0}'}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <!-- Bloco 26: como trabalhar (vale para a conversa). Os botões só valem na última mensagem. -->
                                        <Border Classes="cartao" IsVisible="{Binding EscolheModo}">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="Como você prefere?" FontWeight="SemiBold" FontSize="12" />
                                                <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                        Command="{Binding $parent[UserControl].((vm:AssistenteViewModel)DataContext).EscolherModoCommand}"
                                                        CommandParameter="direto" AutomationProperties.Name="Montar o cronograma agora">
                                                    <StackPanel>
                                                        <TextBlock Text="Montar o cronograma agora" FontWeight="SemiBold" FontSize="12" />
                                                        <TextBlock Text="Com o que já tem e premissas comuns; as premissas vão para a ficha."
                                                                   FontSize="11" TextWrapping="Wrap" Opacity="0.85" />
                                                    </StackPanel>
                                                </Button>
                                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                        Command="{Binding $parent[UserControl].((vm:AssistenteViewModel)DataContext).EscolherModoCommand}"
                                                        CommandParameter="estudo" AutomationProperties.Name="Estudar e conversar antes">
                                                    <StackPanel>
                                                        <TextBlock Text="Estudar e conversar antes" FontWeight="SemiBold" FontSize="12" />
                                                        <TextBlock Text="O assistente lê os documentos, faz algumas perguntas e mostra o plano para você aprovar."
                                                                   FontSize="11" TextWrapping="Wrap" Opacity="0.85" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                        <!-- Bloco 26: perguntas com respostas para clicar (ou escrever). -->
                                        <StackPanel IsVisible="{Binding TemPerguntas}" Spacing="2">
                                            <ItemsControl ItemsSource="{Binding Perguntas}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:PerguntaNaTela">
                                                        <Border Classes="cartao">
                                                            <StackPanel Spacing="2">
                                                                <TextBlock Text="{Binding Texto}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
                                                                <ListBox Classes="opcoes" ItemsSource="{Binding Opcoes}" SelectedItem="{Binding Escolhida}"
                                                                         SelectionMode="Single,Toggle">
                                                                    <ListBox.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel />
                                                                        </ItemsPanelTemplate>
                                                                    </ListBox.ItemsPanel>
                                                                </ListBox>
                                                                <TextBox Text="{Binding Outra}" PlaceholderText="Outra resposta…" FontSize="12"
                                                                         MinHeight="24" Padding="6,2" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button Content="Responder" Classes="accent" FontSize="12" HorizontalAlignment="Right" Margin="0,4,0,0"
                                                    Command="{Binding $parent[UserControl].((vm:AssistenteViewModel)DataContext).ResponderPerguntasCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="Mandar as respostas (o texto da caixa embaixo vai junto, como observação)"
                                                    AutomationProperties.Name="Responder as perguntas" />
                                        </StackPanel>
                                        <!-- Bloco 26: o plano para aprovar antes de montar. -->
                                        <Border Classes="cartao" IsVisible="{Binding TemPlano}">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Plano do cronograma" FontWeight="SemiBold" FontSize="12" />
                                                <ItemsControl ItemsSource="{Binding Plano.Etapas, FallbackValue={x:Null}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:EtapaNaTela">
                                                            <StackPanel Margin="0,1">
                                                                <DockPanel>
                                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Duracao}" FontSize="12" Opacity="0.75" />
                                                                    <TextBlock Text="{Binding Nome}" FontSize="12" TextWrapping="Wrap" />
                                                                </DockPanel>
                                                                <TextBlock Text="{Binding Observacao}" IsVisible="{Binding TemObservacao}" FontSize="11"
                                                                           Opacity="0.65" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="{Binding Plano.Termino, FallbackValue=''}" FontWeight="SemiBold" FontSize="12"
                                                           IsVisible="{Binding Plano.TemTermino, FallbackValue=False}" />
                                                <TextBlock Text="Premissas" FontSize="11" Opacity="0.65" Margin="0,2,0,0"
                                                           IsVisible="{Binding Plano.TemPremissas, FallbackValue=False}" />
                                                <ItemsControl ItemsSource="{Binding Plano.Premissas, FallbackValue={x:Null}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <TextBlock Text="{Binding StringFormat='– {0}'}" FontSize="11" TextWrapping="Wrap" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" Margin="0,4,0,0">
                                                    <Button Content="Ajustar…" FontSize="12"
                                                            Command="{Binding $parent[UserControl].((vm:AssistenteViewModel)DataContext).AjustarPlanoCommand}"
                                                            CommandParameter="{Binding}" ToolTip.Tip="Escrever o que mudar no plano"
                                                            AutomationProperties.Name="Ajustar o plano" />
                                                    <Button Content="Aprovar e montar" Classes="accent" FontSize="12"
                                                            Command="{Binding $parent[UserControl].((vm:AssistenteViewModel)DataContext).AprovarPlanoCommand}"
                                                            CommandParameter="{Binding}" ToolTip.Tip="O assistente monta o cronograma completo seguindo este plano"
                                                            AutomationProperties.Name="Aprovar o plano e montar" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <!-- Bloco 24: o que a resposta fez no cronograma, com Desfazer na última aplicação. -->
                                        <Border Classes="alteracoes" Classes.aplicadas="{Binding Alteracoes.Aplicadas, FallbackValue=False}"
                                                IsVisible="{Binding TemAlteracoes}" CornerRadius="6" Padding="8,5" Margin="0,3,0,0">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{Binding Alteracoes.Texto, FallbackValue=''}" TextWrapping="Wrap" FontSize="12" />
                                                <Button Content="Desfazer" FontSize="12" Padding="8,2" HorizontalAlignment="Left"
                                                        IsVisible="{Binding Alteracoes.PodeDesfazer, FallbackValue=False}"
                                                        Command="{Binding $parent[UserControl].((vm:AssistenteViewModel)DataContext).DesfazerCommand}"
                                                        CommandParameter="{Binding Alteracoes}"
                                                        ToolTip.Tip="Voltar o cronograma para como estava antes desta resposta"
                                                        AutomationProperties.Name="Desfazer as alterações do assistente" />
                                            </StackPanel>
                                        </Border>
                                        <!-- Bloco 41: as atualizações da obra propostas, para aplicar ou descartar. -->
                                        <Border Classes="cartao" IsVisible="{Binding TemCartao}">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{Binding Cartao.Titulo, FallbackValue=''}" FontWeight="SemiBold" FontSize="12" />
                                                <ItemsControl ItemsSource="{Binding Cartao.Itens, FallbackValue={x:Null}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:ItemDoCartaoNaTela">
                                                            <StackPanel Margin="0,1">
                                                                <TextBlock Text="{Binding Texto, StringFormat='• {0}'}" FontSize="12" TextWrapping="Wrap"
                                                                           Opacity="{Binding TemProblema, Converter={x:Static v:Conversores.MeiaOpacidadeSeVerdadeiro}}" />
                                                                <TextBlock Text="{Binding Problema}" IsVisible="{Binding TemProblema}" FontSize="11"
                                                                           Foreground="{DynamicResource TextoDeErro}" TextWrapping="Wrap" Margin="10,0,0,0" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="{Binding Cartao.TextoDoEstado, FallbackValue=''}" FontSize="12" TextWrapping="Wrap"
                                                           IsVisible="{Binding Cartao.TextoDoEstado, FallbackValue='', Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" Margin="0,4,0,0"
                                                            IsVisible="{Binding Cartao.Pendente, FallbackValue=False}">
                                                    <Button Content="Descartar" FontSize="12"
                                                            Command="{Binding $parent[UserControl].((vm:AssistenteViewModel)DataContext).DescartarCartaoCommand}"
                                                            CommandParameter="{Binding Cartao}" AutomationProperties.Name="Descartar as atualizações" />
                                                    <Button Content="{Binding Cartao.TextoDoBotao, FallbackValue='Aplicar'}" Classes="accent" FontSize="12"
                                                            IsEnabled="{Binding Cartao.TemValidos, FallbackValue=False}"
                                                            Command="{Binding $parent[UserControl].((vm:AssistenteViewModel)DataContext).AplicarCartaoCommand}"
                                                            CommandParameter="{Binding Cartao}" ToolTip.Tip="Aplica as atualizações válidas (um passo do Desfazer)"
                                                            AutomationProperties.Name="Aplicar as atualizações" />
                                                </StackPanel>
                                                <Border Classes="alteracoes aplicadas" IsVisible="{Binding Cartao.TemAplicacao, FallbackValue=False}"
                                                        CornerRadius="6" Padding="8,5">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="{Binding Cartao.Aplicacao.Texto, FallbackValue=''}" TextWrapping="Wrap" FontSize="12" />
                                                        <Button Content="Desfazer" FontSize="12" Padding="8,2" HorizontalAlignment="Left"
                                                                IsVisible="{Binding Cartao.Aplicacao.PodeDesfazer, FallbackValue=False}"
                                                                Command="{Binding $parent[UserControl].((vm:AssistenteViewModel)DataContext).DesfazerCommand}"
                                                                CommandParameter="{Binding Cartao.Aplicacao}" AutomationProperties.Name="Desfazer as atualizações" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                        <!-- Bloco 41: a tela que o assistente abriu, para abrir de novo. -->
                                        <Button Content="{Binding Tela.Rotulo, FallbackValue=''}" IsVisible="{Binding TemTela}" FontSize="12" Padding="8,2"
                                                HorizontalAlignment="Left" Margin="0,4,0,0"
                                                Command="{Binding $parent[UserControl].((vm:AssistenteViewModel)DataContext).AbrirTelaCommand}"
                                                CommandParameter="{Binding Tela}" AutomationProperties.Name="Abrir a tela" />
                                        <TextBlock Text="{Binding Hora}" FontSize="10" Opacity="0.55" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.Styles>
                            <!-- Usuário à direita, em azul; assistente à esquerda, em cinza; avisos (erro, cancelamento) em vermelho claro. -->
                            <Style Selector="Border.alteracoes">
                                <Setter Property="Background" Value="{DynamicResource FundoDeAviso}" />
                            </Style>
                            <Style Selector="Border.alteracoes.aplicadas">
                                <Setter Property="Background" Value="{DynamicResource FundoDeSucesso}" />
                            </Style>
                            <Style Selector="Border.balao.doUsuario">
                                <Setter Property="Background" Value="{DynamicResource FundoDoBalaoDoUsuario}" />
                                <Setter Property="HorizontalAlignment" Value="Right" />
                            </Style>
                            <Style Selector="Border.balao.doAssistente">
                                <Setter Property="Background" Value="{DynamicResource FundoDoBalaoDoAssistente}" />
                                <Setter Property="HorizontalAlignment" Value="Left" />
                            </Style>
                            <Style Selector="Border.balao.doAssistente.interativo">
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                            </Style>
                            <Style Selector="Border.balao.erro">
                                <Setter Property="Background" Value="{DynamicResource FundoDoBalaoDeErro}" />
                            </Style>
                        </ItemsControl.Styles>
                    </ItemsControl>
                </ScrollViewer>
            </Panel>
        </DockPanel>
    </Border>
</UserControl>
