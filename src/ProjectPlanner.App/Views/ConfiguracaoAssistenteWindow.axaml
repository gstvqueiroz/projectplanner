<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ProjectPlanner.App.ViewModels"
        x:Class="ProjectPlanner.App.Views.ConfiguracaoAssistenteWindow"
        x:DataType="vm:ConfiguracaoAssistenteViewModel"
        Title="Configurações do assistente"
        Width="560" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <!-- Bloco 23: chave de API (vai para o cofre do sistema, nunca para um arquivo), modelo, teste de conexão. -->
    <StackPanel Margin="20" Spacing="14">
        <StackPanel Spacing="2">
            <TextBlock Text="Assistente de IA" FontSize="16" FontWeight="SemiBold" />
            <TextBlock x:Name="Provedor" Text="{Binding TextoDoProvedor, StringFormat='Provedor: {0}'}" Opacity="0.7" />
        </StackPanel>

        <!-- Bloco 45: a chave própria ou a conta ProjectPlanner -->
        <StackPanel Spacing="6">
            <TextBlock Text="Usar a IA por" FontWeight="SemiBold" />
            <RadioButton x:Name="UsarChavePropria" GroupName="Provedor" IsChecked="{Binding UsarChavePropria}"
                         Content="Minha chave do Gemini (grátis no Google AI Studio)" />
            <RadioButton x:Name="UsarConta" GroupName="Provedor" IsChecked="{Binding UsarConta}"
                         Content="Conta ProjectPlanner (sem chave; cota do plano)" />
            <Border Background="{DynamicResource FundoSutil}" CornerRadius="4" Padding="10,8" IsVisible="{Binding UsarConta}">
                <DockPanel>
                    <Button x:Name="AbrirConta" DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center"
                            Content="{Binding TextoDoBotaoDaConta}" Command="{Binding AbrirContaCommand}" />
                    <TextBlock x:Name="SituacaoDaConta" Text="{Binding SituacaoDaConta}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- A chave em uso (só o fim dela) -->
        <Border Background="{DynamicResource FundoSutil}" CornerRadius="4" Padding="10,8" IsVisible="{Binding UsarChavePropria}">
            <StackPanel Spacing="6">
                <TextBlock x:Name="Situacao" Text="{Binding Situacao}" TextWrapping="Wrap" />
                <TextBlock x:Name="ProblemaNoCofre" Text="{Binding ProblemaNoCofre}" IsVisible="{Binding TemProblemaNoCofre}"
                           TextWrapping="Wrap" Foreground="{DynamicResource TextoDeErroForte}" FontSize="12" />
                <Button x:Name="Remover" Content="Remover chave salva" Command="{Binding RemoverChaveCommand}"
                        IsVisible="{Binding TemChave}" FontSize="12" />
            </StackPanel>
        </Border>

        <StackPanel Spacing="4" IsVisible="{Binding UsarChavePropria}">
            <TextBlock Text="Chave de API" FontWeight="SemiBold" />
            <TextBox x:Name="Chave" Text="{Binding ChaveDigitada}" PasswordChar="●" RevealPassword="False"
                     PlaceholderText="Cole aqui a chave (ela não aparece depois de salva)"
                     AutomationProperties.Name="Chave de API" />
            <TextBlock Text="{Binding DicaDaChave}" TextWrapping="Wrap" FontSize="12" Opacity="0.7" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="Modelo" FontWeight="SemiBold" />
            <DockPanel>
                <Button x:Name="ModeloPadrao" DockPanel.Dock="Right" Margin="8,0,0,0" Command="{Binding RestaurarModeloPadraoCommand}"
                        Content="{Binding ModeloPadrao, StringFormat='Padrão ({0})'}" />
                <TextBox x:Name="Modelo" Text="{Binding Modelo}" AutomationProperties.Name="Modelo" />
            </DockPanel>
        </StackPanel>

        <!-- Bloco 26 -->
        <StackPanel Spacing="4">
            <TextBlock Text="Ao pedir um cronograma" FontWeight="SemiBold" />
            <ComboBox x:Name="ModoAoPedirCronograma" ItemsSource="{x:Static vm:ConfiguracaoAssistenteViewModel.OpcoesDeModo}"
                      SelectedItem="{Binding ModoEscolhido}" HorizontalAlignment="Stretch"
                      AutomationProperties.Name="Ao pedir um cronograma">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:OpcaoDeModo">
                        <TextBlock Text="{Binding Texto}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <TextBlock x:Name="Aviso" Text="{Binding Aviso}" TextWrapping="Wrap" FontSize="12"
                   Foreground="{DynamicResource TextoDeAviso}" />

        <!-- Resultado da última ação -->
        <TextBlock x:Name="Mensagem" Text="{Binding Mensagem}" TextWrapping="Wrap"
                   IsVisible="{Binding Mensagem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Classes.erro="{Binding MensagemEhErro}">
            <TextBlock.Styles>
                <Style Selector="TextBlock.erro">
                    <Setter Property="Foreground" Value="{DynamicResource TextoDeErroForte}" />
                </Style>
            </TextBlock.Styles>
        </TextBlock>

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button x:Name="Testar" Content="Testar conexão" Command="{Binding TestarCommand}" />
            <Button x:Name="Salvar" Content="Salvar" Classes="accent" Command="{Binding SalvarCommand}" />
            <Button x:Name="FecharJanela" Content="Fechar" Click="Fechar" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
