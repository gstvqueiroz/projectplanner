<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ProjectPlanner.App.ViewModels"
        x:Class="ProjectPlanner.App.Views.ConfiguracaoAssistenteWindow"
        x:DataType="vm:ConfiguracaoAssistenteViewModel"
        Title="Configurações do assistente"
        Width="560" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <!-- Blocos 23 e 46: a conta ProjectPlanner, o nível do modelo, o modo e o teste de conexão (sem chave própria na tela). -->
    <StackPanel Margin="20" Spacing="14">
        <StackPanel Spacing="2">
            <TextBlock Text="Assistente de IA" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="Pela sua conta ProjectPlanner" Opacity="0.7" />
        </StackPanel>

        <!-- A conta -->
        <Border Background="{DynamicResource FundoSutil}" CornerRadius="4" Padding="10,8">
            <DockPanel>
                <Button x:Name="AbrirConta" DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center"
                        Content="{Binding TextoDoBotaoDaConta}" Command="{Binding AbrirContaCommand}" />
                <TextBlock x:Name="SituacaoDaConta" Text="{Binding SituacaoDaConta}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <TextBlock x:Name="ChaveDeDesenvolvimento" Text="{Binding TextoDaChaveDeDesenvolvimento}" IsVisible="{Binding ChaveDeDesenvolvimento}"
                   TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextoDeAviso}" />

        <!-- Bloco 46: o nível do modelo -->
        <StackPanel Spacing="4" IsVisible="{Binding TemNiveis}">
            <TextBlock Text="Nível do modelo" FontWeight="SemiBold" />
            <ListBox x:Name="Niveis" ItemsSource="{Binding Niveis}" SelectedItem="{Binding NivelEscolhido}"
                     AutomationProperties.Name="Nível do modelo">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem" x:DataType="vm:OpcaoDeNivel">
                        <Setter Property="IsEnabled" Value="{Binding Habilitado}" />
                        <Setter Property="Padding" Value="10,6" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:OpcaoDeNivel">
                        <StackPanel Spacing="1">
                            <TextBlock Text="{Binding Titulo}" />
                            <TextBlock Text="{Binding Detalhe}" FontSize="12" Opacity="0.7" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="Os créditos são descontados pelo tamanho real de cada pedido. O nível também pode ser trocado no topo do painel."
                       TextWrapping="Wrap" FontSize="12" Opacity="0.7" />
        </StackPanel>

        <!-- Bloco 26 -->
        <StackPanel Spacing="4">
            <TextBlock Text="Ao pedir um cronograma" FontWeight="SemiBold" />
            <ComboBox x:Name="ModoAoPedirCronograma" ItemsSource="{x:Static vm:ConfiguracaoAssistenteViewModel.OpcoesDeModo}"
                      SelectedItem="{Binding ModoEscolhido}" HorizontalAlignment="Stretch"
                      AutomationProperties.Name="Ao pedir um cronograma">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:OpcaoDeModo">
                        <TextBlock Text="{Binding Texto}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <TextBlock x:Name="Aviso" Text="{x:Static vm:ConfiguracaoAssistenteViewModel.AvisoDePrivacidade}" TextWrapping="Wrap" FontSize="12"
                   Foreground="{DynamicResource TextoDeAviso}" />

        <!-- Resultado da última ação -->
        <TextBlock x:Name="Mensagem" Text="{Binding Mensagem}" TextWrapping="Wrap"
                   IsVisible="{Binding Mensagem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Classes.erro="{Binding MensagemEhErro}">
            <TextBlock.Styles>
                <Style Selector="TextBlock.erro">
                    <Setter Property="Foreground" Value="{DynamicResource TextoDeErroForte}" />
                </Style>
            </TextBlock.Styles>
        </TextBlock>

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button x:Name="Testar" Content="Testar conexão" Command="{Binding TestarCommand}" />
            <Button x:Name="FecharJanela" Content="Fechar" Classes="accent" Click="Fechar" IsCancel="True" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
