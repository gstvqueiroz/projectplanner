<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ProjectPlanner.App.ViewModels"
        xmlns:v="using:ProjectPlanner.App.Views"
        x:Class="ProjectPlanner.App.Views.GaleriaFotosWindow"
        x:DataType="vm:GaleriaFotosViewModel"
        Title="{Binding Titulo}"
        Width="1180" Height="760" MinWidth="860" MinHeight="520"
        WindowStartupLocation="CenterOwner">

    <!-- Fotos de uma tarefa (Bloco 22): cabeçalho com a tarefa, ações, filtros, miniaturas por dia e, à direita,
         os detalhes da foto selecionada para editar. Dá para soltar fotos do Finder/Explorer em qualquer lugar. -->
    <Window.Styles>
        <Style Selector="Border.miniatura">
            <Setter Property="Width" Value="176" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="{DynamicResource FundoDaMiniatura}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.miniatura.selecionada">
            <Setter Property="BorderBrush" Value="#6A8CAF" />
            <Setter Property="Background" Value="{DynamicResource FundoDaMiniaturaSelecionada}" />
        </Style>
        <Style Selector="TextBlock.rotulo">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="Margin" Value="0,6,0,2" />
        </Style>
    </Window.Styles>

    <DockPanel Margin="14">
        <!-- Tarefa -->
        <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,10">
            <TextBlock Text="{Binding Titulo}" FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="InfoDaTarefa" Text="{Binding InfoDaTarefa}" Opacity="0.7" />
        </StackPanel>

        <!-- Ações -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button x:Name="Adicionar" Classes="accent" Content="Adicionar fotos…" Command="{Binding AdicionarFotosCommand}" />
                <Button x:Name="Excluir" Content="Excluir" Command="{Binding ExcluirCommand}"
                        ToolTip.Tip="Excluir as fotos selecionadas (Delete)" />
                <Button Content="↺ Girar" Command="{Binding GirarEsquerdaCommand}" ToolTip.Tip="Girar 90° para a esquerda" />
                <Button Content="Girar ↻" Command="{Binding GirarDireitaCommand}" ToolTip.Tip="Girar 90° para a direita" />
                <Button Content="Ampliar" Command="{Binding AmpliarCommand}" CommandParameter="{x:Null}"
                        ToolTip.Tip="Ver a foto ampliada (ou dê dois cliques nela)" />
                <Button Content="Selecionar todas" Command="{Binding SelecionarTodasCommand}" />
            </StackPanel>
            <TextBlock x:Name="Contador" Text="{Binding Contador}" HorizontalAlignment="Right" VerticalAlignment="Center"
                       FontWeight="SemiBold" />
        </DockPanel>

        <!-- Filtros -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource FundoDosFiltros}" CornerRadius="6" Padding="8" Margin="0,0,0,8">
            <WrapPanel ItemSpacing="8" LineSpacing="6">
                <ComboBox ItemsSource="{Binding Atalhos}" SelectedItem="{Binding AtalhoEscolhido}" MinWidth="150" />
                <TextBlock Text="Dia" VerticalAlignment="Center" />
                <CalendarDatePicker SelectedDate="{Binding DiaFiltro}" PlaceholderText="qualquer" Width="130" />
                <TextBlock Text="De" VerticalAlignment="Center" />
                <CalendarDatePicker SelectedDate="{Binding DeFiltro}" PlaceholderText="início" Width="130" />
                <TextBlock Text="Até" VerticalAlignment="Center" />
                <CalendarDatePicker SelectedDate="{Binding AteFiltro}" PlaceholderText="fim" Width="130" />
                <TextBox x:Name="Busca" Text="{Binding TextoFiltro}" PlaceholderText="Buscar em título, legenda, local, autor" Width="250" />
                <ComboBox ItemsSource="{Binding TagsDisponiveis}" SelectedItem="{Binding TagEscolhida}" MinWidth="140" />
                <CheckBox Content="Mais recentes primeiro" IsChecked="{Binding MaisRecentesPrimeiro}" />
                <Button Content="Limpar filtros" Command="{Binding LimparFiltrosCommand}" />
            </WrapPanel>
        </Border>

        <!-- Rodapé: avisos e Fechar -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button Content="Fechar" DockPanel.Dock="Right" Click="Fechar" IsCancel="True" />
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock x:Name="Aviso" Text="{Binding Aviso}" TextWrapping="Wrap" FontSize="12" />
                <TextBlock Text="{Binding ErroDeFiltro}" Foreground="{DynamicResource TextoDeErro}" FontSize="12"
                           IsVisible="{Binding ErroDeFiltro, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
        </DockPanel>

        <!-- Detalhes e edição da foto selecionada -->
        <Border DockPanel.Dock="Right" Width="320" Margin="12,0,0,0" BorderThickness="1,0,0,0" Padding="12,0,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <Panel>
                <TextBlock Text="Selecione uma foto para ver e editar as informações dela." TextWrapping="Wrap" Opacity="0.6"
                           IsVisible="{Binding FotoAtual, Converter={x:Static ObjectConverters.IsNull}}" />
                <ScrollViewer x:Name="Detalhes" IsVisible="{Binding FotoAtual, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <StackPanel Spacing="2">
                        <Border Background="{DynamicResource FundoDaFotoNosDetalhes}" CornerRadius="4" Height="200">
                            <Image Source="{Binding ImagemAtual, Converter={x:Static v:Conversores.Imagem}}" Stretch="Uniform" />
                        </Border>
                        <TextBlock Text="{Binding DetalheDoArquivo}" FontSize="11" Opacity="0.7" Margin="0,4,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding DetalheDoCadastro}" FontSize="11" Opacity="0.7" />

                        <TextBlock Classes="rotulo" Text="Data e hora da foto" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <CalendarDatePicker x:Name="EdicaoData" SelectedDate="{Binding EdicaoData}" Width="140" />
                            <TimePicker SelectedTime="{Binding EdicaoHora}" ClockIdentifier="24HourClock" MinWidth="120" />
                        </StackPanel>
                        <TextBlock Classes="rotulo" Text="Título" />
                        <TextBox x:Name="EdicaoTitulo" Text="{Binding EdicaoTitulo}" MaxLength="120" />
                        <TextBlock Classes="rotulo" Text="Legenda" />
                        <TextBox Text="{Binding EdicaoDescricao}" AcceptsReturn="True" TextWrapping="Wrap" Height="70" MaxLength="2000" />
                        <TextBlock Classes="rotulo" Text="Autor / responsável" />
                        <TextBox Text="{Binding EdicaoAutor}" MaxLength="120" />
                        <TextBlock Classes="rotulo" Text="Local / trecho da obra" />
                        <TextBox Text="{Binding EdicaoLocal}" MaxLength="200" />
                        <TextBlock Classes="rotulo" Text="% concluído da tarefa na data" />
                        <NumericUpDown Value="{Binding EdicaoPercentual}" Minimum="0" Maximum="100" Increment="5" FormatString="0" />
                        <TextBlock Classes="rotulo" Text="Tags (separadas por vírgula)" />
                        <TextBox Text="{Binding EdicaoTags}" PlaceholderText="antes, durante, depois, problema" />
                        <TextBlock Text="{Binding ErroDeEdicao}" Foreground="{DynamicResource TextoDeErro}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"
                                   IsVisible="{Binding ErroDeEdicao, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,10,0,0">
                            <Button x:Name="Aplicar" Classes="accent" Content="Aplicar alterações" Command="{Binding AplicarEdicaoCommand}" />
                            <Button Content="Descartar" Command="{Binding DescartarEdicaoCommand}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Panel>
        </Border>

        <!-- Miniaturas agrupadas por dia -->
        <Panel>
            <TextBlock x:Name="MensagemVazia" Text="{x:Static vm:GaleriaFotosViewModel.SemFotos}" IsVisible="{Binding Vazia}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                       Opacity="0.6" FontSize="15" MaxWidth="420" />
            <TextBlock Text="{x:Static vm:GaleriaFotosViewModel.SemResultado}" IsVisible="{Binding NadaComOsFiltros}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6" FontSize="15" />
            <ScrollViewer>
                <ItemsControl x:Name="Grupos" ItemsSource="{Binding Grupos}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:GrupoNaGaleria">
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="{Binding Cabecalho}" FontWeight="SemiBold" Margin="0,4,0,8" />
                                <ItemsControl ItemsSource="{Binding Fotos}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FotoNaGaleria">
                                            <Border Classes="miniatura" Classes.selecionada="{Binding Selecionada}"
                                                    PointerPressed="MiniaturaApertada" DoubleTapped="MiniaturaDuploClique"
                                                    ToolTip.Tip="{Binding Foto.Imagem.NomeArquivoOriginal}">
                                                <StackPanel Spacing="4">
                                                    <Border Height="124" Background="{DynamicResource FundoDaImagemDaMiniatura}" CornerRadius="4" ClipToBounds="True">
                                                        <Image Source="{Binding Miniatura, Converter={x:Static v:Conversores.Imagem}}" Stretch="UniformToFill" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Rotulo}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Hora}" FontSize="11" Opacity="0.6" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Importando -->
            <Border Background="{DynamicResource FundoDeOcupado}" IsVisible="{Binding Ocupado}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <ProgressBar IsIndeterminate="True" Width="220" />
                    <TextBlock Text="{Binding Progresso}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Panel>
    </DockPanel>
</Window>
