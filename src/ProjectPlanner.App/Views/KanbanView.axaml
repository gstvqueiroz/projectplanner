<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ProjectPlanner.App.ViewModels"
             xmlns:v="using:ProjectPlanner.App.Views"
             x:Class="ProjectPlanner.App.Views.KanbanView"
             x:DataType="vm:KanbanViewModel"
             Focusable="True">
    <!-- Bloco 75 (o plano "Delete, arrastar e Kanban", K1 a K5): o quadro Kanban, as mesmas tarefas da grade e do Gantt. As
         colunas ficam lado a lado (rolagem horizontal), cada uma com a própria rolagem vertical. O arraste dos cards, a guia, a
         dica junto do cursor e a rolagem automática são do KanbanView.axaml.cs. -->
    <UserControl.Styles>
        <Style Selector="Border.coluna">
            <Setter Property="Width" Value="{x:Static v:KanbanView.LarguraDaColuna}" />
            <Setter Property="Background" Value="{DynamicResource FundoDaColunaDoQuadro}" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Border.coluna.acimaDoLimite">
            <Setter Property="Background" Value="{DynamicResource FundoDaColunaAcimaDoLimite}" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource FundoDoCard}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BordaDoCard}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.card.selecionado">
            <Setter Property="BorderBrush" Value="{DynamicResource ContornoDoCardSelecionado}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding" Value="9,7" />
        </Style>
        <Style Selector="Border.card.arrastado">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style Selector="Border.etiqueta">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="0,0,4,3" />
        </Style>
        <Style Selector="TextBlock.secundario">
            <Setter Property="Foreground" Value="{DynamicResource TextoSecundarioDoCard}" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>
        <Style Selector="TextBlock.atrasada">
            <Setter Property="Foreground" Value="{DynamicResource TextoDeErro}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Path.icone">
            <Setter Property="Stroke" Value="{DynamicResource TextoSecundarioDoCard}" />
            <Setter Property="StrokeThickness" Value="1.3" />
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
        <Style Selector="ProgressBar.percentual">
            <Setter Property="MinHeight" Value="4" />
            <Setter Property="Height" Value="4" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Background" Value="{DynamicResource TrilhoDoPercentual}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <ScrollViewer x:Name="Rolagem" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="ListaDeColunas" ItemsSource="{Binding Colunas}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="10" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ColunaNoKanban">
                        <Border Classes="coluna" Classes.acimaDoLimite="{Binding PassouDoLimite}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="12,10,12,8">
                                    <Border DockPanel.Dock="Left" Width="10" Height="10" CornerRadius="5" Margin="0,0,8,0" VerticalAlignment="Center"
                                            Background="{Binding Cor, Converter={x:Static v:Conversores.Cor}}" />
                                    <TextBlock DockPanel.Dock="Right" Classes="secundario" Classes.atrasada="{Binding PassouDoLimite}"
                                               Text="{Binding Contagem}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </DockPanel>
                                <ScrollViewer Classes="cartoes" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl Classes="cartoes" ItemsSource="{Binding Cards}" Margin="8,0,8,10">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="6" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CardNoKanban">
                                                <Border Classes="card" Classes.selecionado="{Binding Selecionado}" Classes.arrastado="{Binding Arrastado}"
                                                        ToolTip.Tip="{Binding Dica}" AutomationProperties.Name="{Binding Nome}">
                                                    <StackPanel Spacing="5">
                                                        <!-- O resumo (K1) e as etiquetas do card -->
                                                        <WrapPanel>
                                                            <Border Classes="etiqueta" Background="{DynamicResource FundoDaEtiquetaDoResumo}"
                                                                    IsVisible="{Binding Resumo, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                                <TextBlock Text="{Binding Resumo}" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                                                            </Border>
                                                            <ItemsControl ItemsSource="{Binding Etiquetas}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:EtiquetaNoCard">
                                                                        <Border Classes="etiqueta" Background="{Binding Cor, Converter={x:Static v:Conversores.Cor}}">
                                                                            <TextBlock Text="{Binding Nome}" FontSize="11" Foreground="White" />
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </WrapPanel>
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Left" Text="◆" Margin="0,0,5,0" IsVisible="{Binding EhMarco}"
                                                                       ToolTip.Tip="Marco" />
                                                            <TextBlock Text="{Binding Nome}" TextWrapping="Wrap" FontWeight="Medium" />
                                                        </DockPanel>
                                                        <DockPanel>
                                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0"
                                                                        IsVisible="{Binding Checklist, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                                        ToolTip.Tip="Itens do checklist marcados">
                                                                <Path Classes="icone" Data="M1.5,1.5 H12.5 V12.5 H1.5 Z M4,7 L6.2,9.2 L10.5,4.5" />
                                                                <TextBlock Classes="secundario" Text="{Binding Checklist}" />
                                                            </StackPanel>
                                                            <TextBlock Classes="secundario" Classes.atrasada="{Binding Atrasada}" Text="{Binding Datas}" />
                                                        </DockPanel>
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right" Classes="secundario" Margin="8,0,0,0"
                                                                       Text="{Binding Percentual, StringFormat={}{0}%}" />
                                                            <ProgressBar Classes="percentual" Minimum="0" Maximum="100" Value="{Binding Percentual}" />
                                                        </DockPanel>
                                                        <StackPanel Orientation="Horizontal" ToolTip.Tip="Responsáveis (os profissionais da tarefa)"
                                                                    IsVisible="{Binding Responsaveis, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                            <Path Classes="icone" Data="M7,1.5 A2.75,2.75 0 1 1 6.99,1.5 Z M1.5,12.5 C1.5,9.5 4,8.2 7,8.2 C10,8.2 12.5,9.5 12.5,12.5" />
                                                            <TextBlock Classes="secundario" Text="{Binding Responsaveis}" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Sem nenhum card: o que é o quadro e como os cards chegam nele. -->
        <TextBlock x:Name="AvisoSemCards" IsVisible="{Binding SemCards}" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420" Classes="secundario" FontSize="13"
                   Text="As tarefas do cronograma aparecem aqui como cards (as que não têm subtarefas). Adicione tarefas pelo menu Tarefa." />

        <!-- O arraste: o card fantasma junto do cursor, a guia azul onde ele vai cair e a dica. -->
        <Canvas x:Name="Sobreposicao" IsHitTestVisible="False" />
    </Panel>
</UserControl>
