<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ProjectPlanner.App.ViewModels"
             xmlns:v="using:ProjectPlanner.App.Views"
             x:Class="ProjectPlanner.App.Views.KanbanView"
             x:DataType="vm:KanbanViewModel"
             Focusable="True">
    <!-- Bloco 75 (o plano "Delete, arrastar e Kanban", K1 a K5): o quadro Kanban, as mesmas tarefas da grade e do Gantt. As
         colunas ficam lado a lado (rolagem horizontal), cada uma com a própria rolagem vertical. O arraste dos cards, a guia, a
         dica junto do cursor e a rolagem automática são do KanbanView.axaml.cs. -->
    <UserControl.Styles>
        <Style Selector="Border.coluna">
            <Setter Property="Width" Value="{x:Static v:KanbanView.LarguraDaColuna}" />
            <Setter Property="Background" Value="{DynamicResource FundoDaColunaDoQuadro}" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Border.coluna.acimaDoLimite">
            <Setter Property="Background" Value="{DynamicResource FundoDaColunaAcimaDoLimite}" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource FundoDoCard}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BordaDoCard}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.card.selecionado">
            <Setter Property="BorderBrush" Value="{DynamicResource ContornoDoCardSelecionado}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding" Value="9,7" />
        </Style>
        <Style Selector="Border.card.arrastado">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style Selector="Border.etiqueta">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="0,0,4,3" />
        </Style>
        <Style Selector="TextBlock.secundario">
            <Setter Property="Foreground" Value="{DynamicResource TextoSecundarioDoCard}" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>
        <Style Selector="TextBlock.atrasada">
            <Setter Property="Foreground" Value="{DynamicResource TextoDeErro}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Path.icone">
            <Setter Property="Stroke" Value="{DynamicResource TextoSecundarioDoCard}" />
            <Setter Property="StrokeThickness" Value="1.3" />
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
        <Style Selector="Button.opcoes">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,0,6,2" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Margin" Value="4,0,-6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.adicionarColuna">
            <Setter Property="Width" Value="220" />
            <Setter Property="Margin" Value="10" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Background" Value="{DynamicResource FundoDaColunaDoQuadro}" />
            <Setter Property="Foreground" Value="{DynamicResource TextoSecundarioDoCard}" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.adicionarCard">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Margin" Value="8,0,8,8" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Foreground" Value="{DynamicResource TextoSecundarioDoCard}" />
        </Style>
        <!-- Bloco 87: o cabeçalho da raia, que recolhe e expande -->
        <Style Selector="Button.raia">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="TextBlock.rotulo">
            <Setter Property="Foreground" Value="{DynamicResource TextoSecundarioDoCard}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style Selector="Border.painel">
            <Setter Property="Background" Value="{DynamicResource FundoDaColunaDoQuadro}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Margin" Value="0,10,10,10" />
            <Setter Property="Width" Value="{x:Static v:KanbanView.LarguraDoPainel}" />
        </Style>
        <Style Selector="ProgressBar.percentual">
            <Setter Property="MinHeight" Value="4" />
            <Setter Property="Height" Value="4" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Background" Value="{DynamicResource TrilhoDoPercentual}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <!-- O card (K4), o mesmo nas colunas e nas células das raias (Bloco 78). -->
    <UserControl.DataTemplates>
        <DataTemplate x:DataType="vm:CardNoKanban">
            <Border Classes="card" Classes.selecionado="{Binding Selecionado}" Classes.arrastado="{Binding Arrastado}"
                    ToolTip.Tip="{Binding Dica}" AutomationProperties.Name="{Binding Nome}">
                <StackPanel Spacing="5">
                    <!-- O resumo (K1) e as etiquetas do card -->
                    <WrapPanel>
                        <Border Classes="etiqueta" Background="{DynamicResource FundoDaEtiquetaDoResumo}"
                                IsVisible="{Binding Resumo, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding Resumo}" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                        </Border>
                        <ItemsControl ItemsSource="{Binding Etiquetas}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:EtiquetaNoCard">
                                    <Border Classes="etiqueta" Background="{Binding Cor, Converter={x:Static v:Conversores.Cor}}">
                                        <TextBlock Text="{Binding Nome}" FontSize="11"
                                                   Foreground="{Binding Cor, Converter={x:Static v:Conversores.TextoSobreACor}}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </WrapPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="◆" Margin="0,0,5,0" IsVisible="{Binding EhMarco}"
                                   ToolTip.Tip="Marco" />
                        <TextBlock Text="{Binding Nome}" TextWrapping="Wrap" FontWeight="Medium" />
                    </DockPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0"
                                    IsVisible="{Binding Checklist, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                    ToolTip.Tip="Itens do checklist marcados">
                            <Path Classes="icone" Data="M1.5,1.5 H12.5 V12.5 H1.5 Z M4,7 L6.2,9.2 L10.5,4.5" />
                            <TextBlock Classes="secundario" Text="{Binding Checklist}" />
                        </StackPanel>
                        <TextBlock Classes="secundario" Classes.atrasada="{Binding Atrasada}" Text="{Binding Datas}" />
                    </DockPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Classes="secundario" Margin="8,0,0,0"
                                   Text="{Binding Percentual, StringFormat={}{0}%}" />
                        <ProgressBar Classes="percentual" Minimum="0" Maximum="100" Value="{Binding Percentual}" />
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" ToolTip.Tip="Responsáveis (os profissionais da tarefa)"
                                IsVisible="{Binding Responsaveis, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <Path Classes="icone" Data="M7,1.5 A2.75,2.75 0 1 1 6.99,1.5 Z M1.5,12.5 C1.5,9.5 4,8.2 7,8.2 C10,8.2 12.5,9.5 12.5,12.5" />
                        <TextBlock Classes="secundario" Text="{Binding Responsaveis}" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.DataTemplates>

    <Panel>
      <DockPanel>
        <!-- Bloco 77 (K5): os filtros (busca, responsável, etiqueta, resumo, atrasadas, vencem nesta semana), as etiquetas do projeto
             e os cards arquivados. -->
        <WrapPanel x:Name="BarraDoQuadro" DockPanel.Dock="Top" Margin="10,8,10,0" Orientation="Horizontal">
            <TextBox x:Name="BuscaNoQuadro" Width="200" Margin="0,0,8,4" PlaceholderText="Buscar nos cards" Text="{Binding Busca}"
                     AutomationProperties.Name="Buscar nos cards" />
            <ComboBox x:Name="FiltroDeResponsavel" Margin="0,0,8,4" MinWidth="170" ItemsSource="{Binding OpcoesDeResponsavel}" SelectedItem="{Binding FiltroResponsavel}"
                      AutomationProperties.Name="Filtrar por responsável">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:OpcaoDeFiltro">
                        <TextBlock Text="{Binding Nome}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox x:Name="FiltroDeEtiqueta" Margin="0,0,8,4" MinWidth="150" ItemsSource="{Binding OpcoesDeEtiqueta}" SelectedItem="{Binding FiltroEtiqueta}"
                      AutomationProperties.Name="Filtrar por etiqueta">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:OpcaoDeFiltro">
                        <TextBlock Text="{Binding Nome}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox x:Name="FiltroDeResumo" Margin="0,0,8,4" MinWidth="150" MaxWidth="260" ItemsSource="{Binding OpcoesDeResumo}" SelectedItem="{Binding FiltroResumo}"
                      AutomationProperties.Name="Filtrar por resumo">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:OpcaoDeFiltro">
                        <TextBlock Text="{Binding Nome}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <ToggleButton x:Name="FiltroAtrasadas" Margin="0,0,8,4" Content="Atrasadas" IsChecked="{Binding SoAtrasadas}"
                          ToolTip.Tip="Só os cards com término antes de hoje e abaixo de 100%" />
            <ToggleButton x:Name="FiltroDaSemana" Margin="0,0,8,4" Content="Vencem nesta semana" IsChecked="{Binding SoDestaSemana}"
                          ToolTip.Tip="Só os cards com término de hoje até domingo, abaixo de 100%" />
            <Button x:Name="BotaoLimparFiltros" Margin="0,0,16,4" Content="Limpar filtros" Command="{Binding LimparFiltrosCommand}" IsVisible="{Binding HaFiltro}" />
            <!-- Bloco 78 (K6) -->
            <ComboBox x:Name="SeletorDeRaias" Margin="0,0,8,4" ItemsSource="{Binding OpcoesDeRaias}" SelectedItem="{Binding Raias}"
                      AutomationProperties.Name="Raias" ToolTip.Tip="Agrupar os cards em raias: por resumo ou por responsável">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:OpcaoDeRaias">
                        <TextBlock Text="{Binding Nome}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <!-- Bloco 87 -->
            <Button x:Name="BotaoRecolherRaias" Margin="0,0,4,4" Content="Recolher raias" Command="{Binding RecolherRaiasCommand}" IsVisible="{Binding ComRaias}"
                    ToolTip.Tip="Todas as raias numa linha só, com a contagem de cada coluna" />
            <Button x:Name="BotaoExpandirRaias" Margin="0,0,8,4" Content="Expandir raias" Command="{Binding ExpandirRaiasCommand}" IsVisible="{Binding ComRaias}"
                    ToolTip.Tip="Todas as raias com os cards" />
            <Button x:Name="BotaoEtiquetas" Margin="0,0,8,4" Content="Etiquetas" Click="AbrirMenuDasEtiquetas"
                    ToolTip.Tip="As etiquetas do projeto: criar, renomear, mudar a cor e excluir" />
            <!-- Bloco 78: o gancho de IA do quadro -->
            <Button x:Name="BotaoResumoDaSemana" Margin="0,0,8,4" Content="Resumo da semana (IA)" Command="{Binding ResumoDaSemanaCommand}"
                    ToolTip.Tip="O assistente escreve o resumo do quadro: concluídas, atrasadas, impedidas e o que vence nesta semana" />
            <Button x:Name="BotaoArquivados" Margin="0,0,8,4" Content="{Binding TextoDosArquivados}" Click="AbrirMenuDosArquivados"
                    ToolTip.Tip="Os cards arquivados (as tarefas continuam no cronograma): abrir ou trazer de volta ao quadro" />
        </WrapPanel>
        <Grid ColumnDefinitions="*,Auto">
        <Panel>
        <ScrollViewer x:Name="Rolagem" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" IsVisible="{Binding !ComRaias}">
          <StackPanel Orientation="Horizontal">
            <ItemsControl x:Name="ListaDeColunas" ItemsSource="{Binding Colunas}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="10,10,0,10" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ColunaNoKanban">
                        <Border Classes="coluna" Classes.acimaDoLimite="{Binding PassouDoLimite}">
                            <DockPanel>
                                <!-- Bloco 76: o menu ⋯ (também com o botão direito no cabeçalho) renomeia, colore, muda o tipo, põe o
                                     limite de cards, reordena e exclui a coluna. -->
                                <DockPanel DockPanel.Dock="Top" Classes="cabecalho" Margin="12,10,12,8" Background="Transparent">
                                    <Button DockPanel.Dock="Right" Classes="opcoes" Content="⋯" Click="AbrirMenuDaColuna"
                                            ToolTip.Tip="Opções da coluna: renomear, cor, tipo, limite de cards, mover e excluir"
                                            AutomationProperties.Name="Opções da coluna" />
                                    <Border DockPanel.Dock="Left" Width="10" Height="10" CornerRadius="5" Margin="0,0,8,0" VerticalAlignment="Center"
                                            Background="{Binding Cor, Converter={x:Static v:Conversores.Cor}}" />
                                    <TextBlock DockPanel.Dock="Right" Classes="secundario" Classes.atrasada="{Binding PassouDoLimite}"
                                               Text="{Binding Contagem}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </DockPanel>
                                <!-- Bloco 77 (K5) -->
                                <Button DockPanel.Dock="Bottom" Classes="adicionarCard" Content="+ Adicionar card" Command="{Binding AdicionarCardCommand}"
                                        ToolTip.Tip="Uma tarefa nova no fim do cronograma (com 1 dia), com o card no fim desta coluna" />
                                <ScrollViewer Classes="cartoes" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl Classes="cartoes" ItemsSource="{Binding Cards}" Margin="8,0,8,10">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="6" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- Bloco 76 -->
            <Button x:Name="BotaoAdicionarColuna" Classes="adicionarColuna" Content="+ Adicionar coluna" Command="{Binding AdicionarColunaCommand}"
                    ToolTip.Tip="Uma coluna nova, antes de Concluída (do tipo Em andamento, como uma &quot;Em revisão&quot;)" />
          </StackPanel>
        </ScrollViewer>

        <!-- Bloco 78 (K6): as raias × colunas, cada raia com uma célula por coluna. Arrastar um card para outra raia muda o resumo
             ou o responsável da tarefa. Bloco 87: os cabeçalhos das colunas ficam fixos no alto (a rolagem horizontal deles segue a
             das raias, pelo KanbanView.axaml.cs); o nome da raia que passou do alto fica numa etiqueta; cada raia recolhe e expande
             (recolhida, só a contagem de cada coluna, e ainda dá para soltar cards nela). -->
        <DockPanel x:Name="QuadroComRaias" IsVisible="{Binding ComRaias}">
            <ScrollViewer x:Name="CabecalhoDasRaias" DockPanel.Dock="Top" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Colunas}" Margin="10,10,10,6">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="10" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ColunaNoKanban">
                            <Border Classes="coluna" Classes.acimaDoLimite="{Binding PassouDoLimite}">
                                <DockPanel Classes="cabecalho" Margin="12,9,12,9" Background="Transparent">
                                    <Button DockPanel.Dock="Right" Classes="opcoes" Content="⋯" Click="AbrirMenuDaColuna"
                                            ToolTip.Tip="Opções da coluna: renomear, cor, tipo, limite de cards, mover e excluir"
                                            AutomationProperties.Name="Opções da coluna" />
                                    <Border DockPanel.Dock="Left" Width="10" Height="10" CornerRadius="5" Margin="0,0,8,0" VerticalAlignment="Center"
                                            Background="{Binding Cor, Converter={x:Static v:Conversores.Cor}}" />
                                    <TextBlock DockPanel.Dock="Right" Classes="secundario" Classes.atrasada="{Binding PassouDoLimite}"
                                               Text="{Binding Contagem}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Panel>
                <ScrollViewer x:Name="RolagemDasRaias" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ListaDeRaias" ItemsSource="{Binding RaiasNaTela}" Margin="10,4,10,10">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="12" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RaiaNoKanban">
                                <StackPanel Spacing="4">
                                    <Button Classes="raia" Command="{Binding AlternarCommand}" ToolTip.Tip="{Binding DicaDaSeta}"
                                            AutomationProperties.Name="{Binding Nome}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Seta}" Width="12" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Classes="secundario" Text="{Binding Contagem}" VerticalAlignment="Center" />
                                            <ProgressBar Classes="percentual" Width="70" Minimum="0" Maximum="100" Value="{Binding Percentual}" Margin="6,0,0,0"
                                                         IsVisible="{Binding Andamento, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            <TextBlock Classes="secundario" Text="{Binding Andamento}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <ItemsControl ItemsSource="{Binding Celulas}" IsVisible="{Binding !Recolhida}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="10" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CelulaNoKanban">
                                                <Border Classes="celula" Width="{x:Static v:KanbanView.LarguraDaColuna}" MinHeight="46" CornerRadius="8" Padding="8"
                                                        Background="{DynamicResource FundoDaColunaDoQuadro}">
                                                    <ItemsControl Classes="cartoes" ItemsSource="{Binding Cards}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Spacing="6" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                    </ItemsControl>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <!-- Bloco 87: recolhida, uma linha fina com a contagem de cada coluna (soltar um card aqui leva para a raia). -->
                                    <ItemsControl ItemsSource="{Binding Celulas}" IsVisible="{Binding Recolhida}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="10" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CelulaNoKanban">
                                                <Border Classes="celula recolhida" Width="{x:Static v:KanbanView.LarguraDaColuna}" Height="30" CornerRadius="6" Padding="12,0"
                                                        Background="{DynamicResource FundoDaColunaDoQuadro}">
                                                    <TextBlock Classes="secundario" Text="{Binding Contagem}" VerticalAlignment="Center" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <!-- Bloco 87: a raia cujo nome já passou do alto, para saber onde se está ao rolar. -->
                <Border x:Name="RaiaNoAlto" IsVisible="False" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="10,0,0,0" Padding="10,4" CornerRadius="0,0,6,6" Background="{DynamicResource FundoDaColunaDoQuadro}">
                    <TextBlock x:Name="TextoDaRaiaNoAlto" FontWeight="SemiBold" FontSize="12" />
                </Border>
            </Panel>
        </DockPanel>

        <!-- Sem nenhum card: o que é o quadro e como os cards chegam nele. -->
        <TextBlock x:Name="AvisoSemCards" IsVisible="{Binding SemCards}" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420" Classes="secundario" FontSize="13"
                   Text="As tarefas do cronograma aparecem aqui como cards (as que não têm subtarefas). Adicione tarefas pelo menu Tarefa." />

        <TextBlock x:Name="AvisoDoFiltro" IsVisible="{Binding NenhumNoFiltro}" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Classes="secundario" FontSize="13" Text="Nenhum card com esses filtros. Use Limpar filtros, no alto do quadro, para ver todos." />
        </Panel>

        <!-- Bloco 77 (K4): o painel do card (duplo clique num card). Os campos são os da linha da tarefa na grade: as mesmas
             validações e o mesmo Desfazer. -->
        <Border x:Name="PainelDoCard" Grid.Column="1" Classes="painel" IsVisible="{Binding Painel, Converter={x:Static ObjectConverters.IsNotNull}}">
            <DockPanel DataContext="{Binding Painel}" x:DataType="vm:PainelDoCard">
                <DockPanel DockPanel.Dock="Top" Margin="14,10,8,0">
                    <Button DockPanel.Dock="Right" Classes="opcoes" Content="✕" Command="{Binding FecharCommand}" ToolTip.Tip="Fechar o card"
                            AutomationProperties.Name="Fechar o card" />
                    <TextBlock Classes="secundario" Text="{Binding Identificacao}" VerticalAlignment="Center" />
                </DockPanel>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="14,4,14,14" Spacing="4">
                        <Border Classes="etiqueta" HorizontalAlignment="Left" Background="{DynamicResource FundoDaEtiquetaDoResumo}"
                                IsVisible="{Binding Resumo, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding Resumo}" FontSize="11" />
                        </Border>
                        <TextBox x:Name="NomeNoPainel" Text="{Binding Linha.Nome, UpdateSourceTrigger=LostFocus}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                                 AutomationProperties.Name="Nome da tarefa" />
                        <TextBlock Classes="secundario" Text="{Binding Coluna, StringFormat=Na coluna {0}}" />
                        <TextBlock Classes="atrasada" Text="Arquivado: o card não aparece no quadro (a tarefa continua no cronograma)." TextWrapping="Wrap"
                                   IsVisible="{Binding Arquivado}" />
                        <Grid ColumnDefinitions="*,10,*" RowDefinitions="Auto,Auto,Auto,Auto">
                            <TextBlock Classes="rotulo" Text="Início" />
                            <CalendarDatePicker Grid.Row="1" HorizontalAlignment="Stretch" SelectedDate="{Binding Linha.DataInicio}" />
                            <TextBlock Grid.Column="2" Classes="rotulo" Text="Término" />
                            <CalendarDatePicker Grid.Row="1" Grid.Column="2" HorizontalAlignment="Stretch" SelectedDate="{Binding Linha.DataTermino}" />
                            <TextBlock Grid.Row="2" Classes="rotulo" Text="Duração (dias úteis)" />
                            <TextBox Grid.Row="3" Text="{Binding Linha.Duracao, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Classes="rotulo" Text="% concluído" />
                            <TextBox x:Name="PercentualNoPainel" Grid.Row="3" Grid.Column="2" Text="{Binding Linha.PercentualConcluido, UpdateSourceTrigger=LostFocus}" />
                        </Grid>
                        <TextBlock Classes="rotulo" Text="Predecessoras" />
                        <TextBox Text="{Binding Linha.Predecessoras, UpdateSourceTrigger=LostFocus}" PlaceholderText="ex.: 2; 3II+2" />
                        <TextBlock Classes="rotulo" Text="Responsáveis" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Recursos…" Command="{Binding RecursosCommand}" Margin="8,0,0,0"
                                    ToolTip.Tip="Os recursos da tarefa (os profissionais são os responsáveis)" />
                            <TextBlock Text="{Binding Responsaveis, TargetNullValue=Nenhum profissional na tarefa}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Classes="rotulo" Text="Etiquetas" />
                        <WrapPanel>
                            <ItemsControl ItemsSource="{Binding Etiquetas}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:EtiquetaNoPainel">
                                        <CheckBox IsChecked="{Binding Marcada}" Margin="0,0,10,0">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <Ellipse Width="9" Height="9" Fill="{Binding Cor, Converter={x:Static v:Conversores.Cor}}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Nome}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Classes="adicionarCard" Margin="0" Content="+ Nova etiqueta…" Command="{Binding NovaEtiquetaCommand}" HorizontalAlignment="Left" />
                        </WrapPanel>
                        <TextBlock Classes="rotulo" Text="Descrição" />
                        <TextBox Text="{Binding Linha.Notas, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72"
                                 PlaceholderText="As notas da tarefa (as mesmas da grade)" />
                        <DockPanel Margin="0,6,0,0">
                            <TextBlock DockPanel.Dock="Right" Classes="secundario" Text="{Binding ProgressoDoChecklist}" VerticalAlignment="Bottom" />
                            <TextBlock Classes="rotulo" Margin="0" Text="Checklist" />
                        </DockPanel>
                        <ItemsControl x:Name="ChecklistNoPainel" ItemsSource="{Binding Checklist}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ItemNoPainel">
                                    <DockPanel Margin="0,1">
                                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Feito}" MinWidth="0" Margin="0,0,4,0" />
                                        <Button DockPanel.Dock="Right" Classes="opcoes" Content="✕" FontSize="12" Command="{Binding RemoverCommand}"
                                                ToolTip.Tip="Tirar o item do checklist" AutomationProperties.Name="Tirar o item" />
                                        <TextBox Text="{Binding Texto, UpdateSourceTrigger=LostFocus}" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Adicionar" Command="{Binding AdicionarItemCommand}" Margin="8,0,0,0" />
                            <TextBox x:Name="NovoItemDoChecklist" Text="{Binding NovoItem}" PlaceholderText="Novo item do checklist (Enter adiciona)" />
                        </DockPanel>
                        <DockPanel>
                            <!-- Bloco 78: o gancho de IA do checklist -->
                            <Button x:Name="BotaoSugerirItens" DockPanel.Dock="Right" Classes="adicionarCard" Margin="8,0,0,0" Content="Sugerir itens (IA)"
                                    Command="{Binding SugerirItensCommand}"
                                    ToolTip.Tip="A IA sugere os itens de execução e conferência a partir da tarefa; eles entram desmarcados, para você revisar" />
                            <TextBlock Classes="secundario" TextWrapping="Wrap" VerticalAlignment="Center" Text="Marcar os itens não muda o % concluído." />
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                            <Button Content="Arquivar card" Command="{Binding ArquivarCommand}" IsVisible="{Binding !Arquivado}"
                                    ToolTip.Tip="Esconde o card do quadro; a tarefa continua no cronograma" />
                            <Button Content="Desarquivar" Command="{Binding DesarquivarCommand}" IsVisible="{Binding Arquivado}" />
                            <Button Content="Excluir tarefa" Command="{Binding ExcluirCommand}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
        </Grid>
      </DockPanel>

        <!-- O arraste: o card fantasma junto do cursor, a guia azul onde ele vai cair e a dica. -->
        <Canvas x:Name="Sobreposicao" IsHitTestVisible="False" />
    </Panel>
</UserControl>
