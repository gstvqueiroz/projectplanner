<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ProjectPlanner.App.ViewModels"
        x:Class="ProjectPlanner.App.Views.LinhasDeBaseWindow"
        x:DataType="vm:LinhasDeBaseViewModel"
        Title="Linhas de base"
        Width="560" Height="420" MinWidth="460" MinHeight="300"
        WindowStartupLocation="CenterOwner">

    <!-- Bloco 31: as linhas de base salvas, a em uso e remover. -->
    <DockPanel Margin="18">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,10"
                   Text="A linha de base em uso é a que a grid (colunas de linha de base e desvio), o Gantt (barra cinza) e a Curva S comparam com o cronograma atual." />
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                <Button Content="Não comparar" Command="{Binding UsarNenhumaCommand}" />
                <Button Content="Fechar" Click="Fechar" IsCancel="True" IsDefault="True" />
            </StackPanel>
            <TextBlock x:Name="Mensagem" Text="{Binding Mensagem}" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12" />
        </DockPanel>
        <Panel>
            <TextBlock Text="{x:Static vm:LinhasDeBaseViewModel.SemLinhas}" IsVisible="{Binding Vazia}" TextWrapping="Wrap"
                       Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
            <ScrollViewer>
                <ItemsControl x:Name="Linhas" ItemsSource="{Binding Linhas}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LinhaDeBaseNaLista">
                            <Border Padding="10,8" Margin="0,0,0,6" CornerRadius="6" Background="{DynamicResource FundoDosFiltros}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="Em uso" FontWeight="SemiBold" VerticalAlignment="Center" IsVisible="{Binding EmUso}" />
                                        <Button Content="Usar" IsVisible="{Binding !EmUso}"
                                                Command="{Binding $parent[Window].((vm:LinhasDeBaseViewModel)DataContext).UsarCommand}" CommandParameter="{Binding}" />
                                        <Button Content="Remover"
                                                Command="{Binding $parent[Window].((vm:LinhasDeBaseViewModel)DataContext).RemoverCommand}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Descricao}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Detalhe}" FontSize="12" Opacity="0.7" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Panel>
    </DockPanel>
</Window>
