<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ProjectPlanner.App.ViewModels"
        xmlns:v="using:ProjectPlanner.App.Views"
        x:Class="ProjectPlanner.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/ProjectPlanner.ico"
        Title="{Binding Titulo}"
        Width="1340" Height="700" MinWidth="900" MinHeight="400"
        WindowState="Maximized">

    <DockPanel>
        <!-- Barra de ferramentas -->
        <Border DockPanel.Dock="Top" Padding="8" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <!-- WrapPanel: em janelas estreitas os controles da direita passam para uma segunda linha. -->
            <WrapPanel ItemSpacing="6" LineSpacing="6">
                <Button Content="Novo" Command="{Binding NovoProjetoCommand}" />
                <Button Content="Abrir…" Command="{Binding AbrirProjetoCommand}" />
                <Button Content="Salvar" Command="{Binding SalvarProjetoCommand}" />
                <Button Content="Salvar como…" Command="{Binding SalvarComoProjetoCommand}" />
                <Border Width="1" Height="24" Margin="6,0" VerticalAlignment="Center" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />
                <Button Content="Adicionar tarefa" Command="{Binding AdicionarTarefaCommand}" />
                <Button Content="Remover tarefa" Command="{Binding RemoverTarefaCommand}" />
                <Border Width="1" Height="24" Margin="6,0" VerticalAlignment="Center" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />
                <Button Content="Recalcular cronograma" Command="{Binding RecalcularCronogramaCommand}" />
                <Border Width="1" Height="24" Margin="6,0" VerticalAlignment="Center" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />
                <TextBlock Text="Zoom:" VerticalAlignment="Center" ToolTip.Tip="Zoom do Gantt" />
                <Slider Width="130" VerticalAlignment="Center"
                        Minimum="{x:Static vm:GanttViewModel.EscalaMinima}"
                        Maximum="{x:Static vm:GanttViewModel.EscalaMaxima}"
                        Value="{Binding Gantt.PixelsPorDia}" />
                <TextBlock Text="{Binding Gantt.PixelsPorDia, StringFormat={}{0:0} px/dia}" VerticalAlignment="Center" MinWidth="62" />
                <!-- Opções de exibição, valem só durante a sessão (não vão para o .pplan). -->
                <Border Width="1" Height="24" Margin="6,0" VerticalAlignment="Center" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />
                <TextBlock Text="Mostrar:" VerticalAlignment="Center" />
                <CheckBox Content="Seleção" IsChecked="{Binding MostrarSelecao}" VerticalAlignment="Center"
                          ToolTip.Tip="Destacar a tarefa selecionada na grid e no Gantt" />
                <CheckBox Content="Caminho crítico" IsChecked="{Binding Gantt.MostrarCaminhoCritico}" VerticalAlignment="Center"
                          ToolTip.Tip="Pintar de vermelho as tarefas e vínculos críticos no Gantt" />
            </WrapPanel>
        </Border>

        <!-- Dados do projeto -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="8">
            <TextBlock Text="Projeto:" VerticalAlignment="Center" />
            <TextBox Width="320" Text="{Binding NomeProjeto, UpdateSourceTrigger=LostFocus}" />
            <TextBlock Text="Início:" VerticalAlignment="Center" Margin="12,0,0,0" />
            <CalendarDatePicker SelectedDate="{Binding InicioProjeto}" />
            <TextBlock Text="Término:" VerticalAlignment="Center" Margin="12,0,0,0" />
            <TextBlock Text="{Binding TerminoProjeto, StringFormat={}{0:d}}" VerticalAlignment="Center" FontWeight="SemiBold" />
        </StackPanel>

        <!-- Barra de status -->
        <Border DockPanel.Dock="Bottom" Padding="8,4" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <TextBlock Text="{Binding Mensagem}" TextTrimming="CharacterEllipsis" />
        </Border>

        <!-- Grid à esquerda e Gantt à direita, com divisor arrastável. As linhas e o cabeçalho dos dois
             têm a mesma altura (GanttViewModel.AlturaLinha e AlturaCabecalho), e a grid comanda a
             rolagem vertical do Gantt (ver MainWindow.axaml.cs). -->
        <Grid ColumnDefinitions="620,6,*" Margin="8,0,8,8">
        <!-- Grid de tarefas. Nº, Predecessoras editáveis na notação "2; 3II+2" (ver NotacaoPredecessoras). -->
        <DataGrid x:Name="Grade"
                  Grid.Column="0"
                  RowHeight="{x:Static vm:GanttViewModel.AlturaLinhaDaGrade}"
                  ColumnHeaderHeight="{x:Static vm:GanttViewModel.AlturaCabecalho}"
                  ItemsSource="{Binding Tarefas}"
                  SelectedItem="{Binding TarefaSelecionada}"
                  SelectionMode="Single"
                  CellEditEnded="GradeCellEditEnded"
                  AutoGenerateColumns="False"
                  CanUserSortColumns="False"
                  CanUserReorderColumns="False"
                  GridLinesVisibility="All"
                  Classes.semSelecao="{Binding !MostrarSelecao}"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <DataGrid.Styles>
                <Style Selector="DataGridCell">
                    <Setter Property="FontSize" Value="13" />
                </Style>
                <!-- Seleção sutil: em vez do fundo azul do tema, um contorno cinza-azulado de 2 px desenhado
                     no retângulo de fundo da linha (não muda a altura, que precisa bater com o Gantt).
                     A mesma cor contorna a linha no Gantt (GanttChartView). -->
                <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
                    <Setter Property="Fill" Value="Transparent" />
                    <Setter Property="Stroke" Value="#6A8CAF" />
                    <Setter Property="StrokeThickness" Value="2" />
                    <Setter Property="Opacity" Value="1" />
                </Style>
                <!-- "Mostrar seleção" desligado: nenhum destaque na linha nem na célula atual. A seleção
                     continua existindo (Remover tarefa, edição inline). -->
                <Style Selector="DataGrid.semSelecao DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
                    <Setter Property="Opacity" Value="0" />
                </Style>
                <Style Selector="DataGrid.semSelecao DataGridCell /template/ Grid#FocusVisual">
                    <Setter Property="IsVisible" Value="False" />
                </Style>
                <Style Selector="DataGridRow" x:DataType="vm:TarefaViewModel">
                    <Setter Property="Background"
                            Value="{Binding EhCritica, Converter={x:Static v:Conversores.FundoDaTarefaCritica}}" />
                </Style>
            </DataGrid.Styles>

            <DataGrid.Columns>
                <DataGridTextColumn x:DataType="vm:TarefaViewModel" Header="Nº" Width="65" Binding="{Binding Numero}" IsReadOnly="True" />
                <DataGridTextColumn x:DataType="vm:TarefaViewModel" Header="Nome" Binding="{Binding Nome}" Width="130" />
                <DataGridTextColumn x:DataType="vm:TarefaViewModel" Header="Duração&#x0a;(dias)" Width="104" Binding="{Binding Duracao}" />

                <DataGridTemplateColumn x:DataType="vm:TarefaViewModel" Header="Início" Width="104">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:TarefaViewModel">
                            <TextBlock Text="{Binding DataInicio, StringFormat={}{0:d}}" VerticalAlignment="Center" Margin="12,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate x:DataType="vm:TarefaViewModel">
                            <CalendarDatePicker SelectedDate="{Binding DataInicio}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn x:DataType="vm:TarefaViewModel" Header="Término" Width="104">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:TarefaViewModel">
                            <TextBlock Text="{Binding DataTermino, StringFormat={}{0:d}}" VerticalAlignment="Center" Margin="12,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate x:DataType="vm:TarefaViewModel">
                            <CalendarDatePicker SelectedDate="{Binding DataTermino}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn x:DataType="vm:TarefaViewModel" Header="%&#x0a;Concl." Width="80" Binding="{Binding PercentualConcluido}" />
                <DataGridTextColumn x:DataType="vm:TarefaViewModel" Header="Predecessoras" Binding="{Binding Predecessoras}" Width="130" />

                <DataGridTextColumn x:DataType="vm:TarefaViewModel" Header="Início&#x0a;cedo" Width="104" Binding="{Binding InicioMaisCedo, StringFormat={}{0:d}}" IsReadOnly="True" />
                <DataGridTextColumn x:DataType="vm:TarefaViewModel" Header="Término&#x0a;cedo" Width="104" Binding="{Binding TerminoMaisCedo, StringFormat={}{0:d}}" IsReadOnly="True" />
                <DataGridTextColumn x:DataType="vm:TarefaViewModel" Header="Início&#x0a;tarde" Width="104" Binding="{Binding InicioMaisTarde, StringFormat={}{0:d}}" IsReadOnly="True" />
                <DataGridTextColumn x:DataType="vm:TarefaViewModel" Header="Término&#x0a;tarde" Width="104" Binding="{Binding TerminoMaisTarde, StringFormat={}{0:d}}" IsReadOnly="True" />
                <DataGridTextColumn x:DataType="vm:TarefaViewModel" Header="Folga&#x0a;(dias)" Width="85" Binding="{Binding Folga}" IsReadOnly="True" />
                <DataGridTextColumn x:DataType="vm:TarefaViewModel" Header="Crítica" Width="90"
                                    Binding="{Binding EhCritica, Converter={x:Static v:Conversores.SimOuVazio}}" IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>

        <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="Transparent" />

        <Border Grid.Column="2" BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <v:GanttChartView x:Name="Gantt" DataContext="{Binding Gantt}" />
        </Border>
        </Grid>
    </DockPanel>
</Window>
