<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ProjectPlanner.App.ViewModels"
        xmlns:v="using:ProjectPlanner.App.Views"
        x:Class="ProjectPlanner.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/ProjectPlanner.ico"
        Title="{Binding Titulo}"
        Width="1340" Height="700" MinWidth="900" MinHeight="400"
        WindowState="Maximized">

    <Window.Styles>
        <!-- Botões da barra de acesso rápido: só o ícone, sem fundo até o mouse passar por cima. -->
        <Style Selector="Button.acessoRapido">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.acessoRapido Path">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="StrokeThickness" Value="1.4" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
        </Style>
        <!-- Ação indisponível (CanExecute falso): ícone esmaecido, sem a caixa cinza que o tema põe nos botões. -->
        <Style Selector="Button.acessoRapido:disabled Path">
            <Setter Property="Opacity" Value="0.3" />
        </Style>
        <Style Selector="Button.acessoRapido:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <!-- Modo de visualização atual, na faixa: botão marcado. -->
        <Style Selector="Button.acessoRapido.ativo /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#D6E4F0" />
        </Style>
        <!-- Botões − e + do zoom flutuante: redondos, sem fundo até o mouse passar. -->
        <Style Selector="Button.zoom">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.zoom:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="StackPanel#AcessoRapido > Border.divisor">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <!-- Linha 1: o menu principal (Arquivo, Exibir, Tarefa; Inserir oculto por ora), como num aplicativo desktop clássico.
             Cada item dispara o mesmo comando ou liga a mesma propriedade do ViewModel que o botão da antiga
             barra de ferramentas; o submenu Exibir > Colunas é montado no MainWindow.axaml.cs, uma caixa por
             coluna. Promover e Rebaixar só mostram o atalho: quem trata Alt+Shift+← e → é a própria janela
             (AtalhosDaEstrutura). -->
        <Border DockPanel.Dock="Top" Padding="4,0" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <Menu x:Name="MenuPrincipal">
                <MenuItem Header="Arquivo">
                    <MenuItem x:Name="ItemNovo" Header="Novo" Command="{Binding NovoProjetoCommand}" />
                    <MenuItem x:Name="ItemAbrir" Header="Abrir…" Command="{Binding AbrirProjetoCommand}" />
                    <Separator />
                    <MenuItem x:Name="ItemSalvar" Header="Salvar" Command="{Binding SalvarProjetoCommand}" />
                    <MenuItem x:Name="ItemSalvarComo" Header="Salvar como…" Command="{Binding SalvarComoProjetoCommand}" />
                    <Separator />
                    <!-- Bloco 25 (E1) -->
                    <MenuItem Header="Exportar para CSV…" Command="{Binding ExportarCsvCommand}"
                              ToolTip.Tip="A tabela do cronograma numa planilha CSV, que o Excel abre direto" />
                </MenuItem>
                <!-- Opções de exibição: valem só durante a sessão (não vão para o .pplan). O ✓ mostra se estão ligadas. -->
                <MenuItem Header="Exibir">
                    <MenuItem Header="Seleção" ToggleType="CheckBox" IsChecked="{Binding MostrarSelecao, Mode=TwoWay}"
                              ToolTip.Tip="Destacar a tarefa selecionada na grid e no Gantt" />
                    <MenuItem Header="Caminho crítico" ToggleType="CheckBox"
                              IsChecked="{Binding Gantt.MostrarCaminhoCritico, Mode=TwoWay}"
                              ToolTip.Tip="Pintar de vermelho as tarefas e vínculos críticos no Gantt" />
                    <MenuItem Header="Fotos" ToggleType="CheckBox" IsChecked="{Binding Gantt.MostrarFotos, Mode=TwoWay}"
                              ToolTip.Tip="Mostrar a câmera ao lado das tarefas que têm fotos (clique nela para ver a galeria)" />
                    <MenuItem Header="Folga" ToggleType="CheckBox" IsChecked="{Binding Gantt.MostrarFolga, Mode=TwoWay}"
                              ToolTip.Tip="Mostrar a linha cinza da folga total, abaixo da barra de cada tarefa" />
                    <!-- Bloco 25 (C1) -->
                    <MenuItem Header="Linha Hoje" ToggleType="CheckBox" IsChecked="{Binding Gantt.MostrarHoje, Mode=TwoWay}"
                              ToolTip.Tip="A linha tracejada do dia de hoje no Gantt" />
                    <Separator />
                    <!-- Modos de visualização (Bloco 16): quais painéis aparecem. Só da sessão. -->
                    <MenuItem x:Name="ItemDividido" Header="Dividido" ToggleType="Radio" GroupName="ModoVisualizacao"
                              IsChecked="{Binding EhDividido, Mode=OneWay}"
                              Command="{Binding DefinirModoVisualizacaoCommand}" CommandParameter="{x:Static vm:ModoVisualizacao.Dividido}"
                              ToolTip.Tip="Tabela e Gantt lado a lado" />
                    <MenuItem x:Name="ItemSomenteTabela" Header="Somente Tabela" ToggleType="Radio" GroupName="ModoVisualizacao"
                              IsChecked="{Binding EhSomenteTabela, Mode=OneWay}"
                              Command="{Binding DefinirModoVisualizacaoCommand}" CommandParameter="{x:Static vm:ModoVisualizacao.SomenteTabela}"
                              ToolTip.Tip="Só a grid de tarefas, na largura toda" />
                    <MenuItem x:Name="ItemSomenteGantt" Header="Somente Gantt" ToggleType="Radio" GroupName="ModoVisualizacao"
                              IsChecked="{Binding EhSomenteGantt, Mode=OneWay}"
                              Command="{Binding DefinirModoVisualizacaoCommand}" CommandParameter="{x:Static vm:ModoVisualizacao.SomenteGantt}"
                              ToolTip.Tip="Só o Gantt, na largura toda" />
                    <Separator />
                    <!-- Mostrar/ocultar colunas e restaurar o layout padrão. Ordem e largura mudam arrastando os
                         cabeçalhos; tudo fica salvo em colunas.json (ver ArquivoPreferenciasColunas). -->
                    <MenuItem x:Name="MenuColunas" Header="Colunas" />
                    <Separator />
                    <!-- Painel do assistente de IA (Bloco 19); fica salvo entre as sessões. -->
                    <MenuItem x:Name="ItemAssistente" Header="Assistente (IA)" ToggleType="CheckBox" IsChecked="{Binding Assistente.Visivel, Mode=TwoWay}"
                              ToolTip.Tip="Mostrar ou ocultar o painel do assistente, à direita" />
                </MenuItem>
                <!-- Inserir: vazio e oculto por ora (Bloco 15.1). Volta quando chegar a primeira funcionalidade dele
                     (ex.: data limite, anexos, comentários, link, coluna personalizada). -->
                <MenuItem Header="Inserir" IsVisible="False" />
                <!-- Tudo o que cria, remove ou reorganiza tarefas, num lugar só. -->
                <MenuItem Header="Tarefa">
                    <MenuItem Header="Adicionar tarefa" Command="{Binding AdicionarTarefaCommand}" />
                    <!-- Bloco 21: tarefa nova junto da selecionada, entre as irmãs dela. -->
                    <MenuItem Header="Inserir tarefa acima" Command="{Binding InserirTarefaAcimaCommand}"
                              ToolTip.Tip="Uma tarefa nova logo antes da selecionada, no mesmo nível" />
                    <MenuItem Header="Inserir tarefa abaixo" Command="{Binding InserirTarefaAbaixoCommand}"
                              ToolTip.Tip="Uma tarefa nova logo depois da selecionada (e das subtarefas dela), no mesmo nível" />
                    <MenuItem Header="Adicionar subtarefa" Command="{Binding AdicionarSubtarefaCommand}"
                              ToolTip.Tip="Adicionar uma subtarefa dentro da tarefa selecionada" />
                    <MenuItem Header="Adicionar marco" Command="{Binding AdicionarMarcoCommand}"
                              ToolTip.Tip="Adicionar um marco (tarefa de duração 0) no fim da lista" />
                    <MenuItem Header="Adicionar resumo" Command="{Binding AdicionarResumoCommand}"
                              ToolTip.Tip="Adicionar no fim da lista um resumo com uma subtarefa dentro" />
                    <Separator />
                    <MenuItem Header="Remover tarefa" Command="{Binding RemoverTarefaCommand}" />
                    <Separator />
                    <MenuItem Header="Promover" Command="{Binding PromoverCommand}" InputGesture="Alt+Shift+Left"
                              ToolTip.Tip="Tira a tarefa do resumo, um nível acima" />
                    <MenuItem Header="Rebaixar" Command="{Binding RebaixarCommand}" InputGesture="Alt+Shift+Right"
                              ToolTip.Tip="Coloca a tarefa dentro da tarefa de cima, um nível abaixo" />
                    <Separator />
                    <MenuItem x:Name="ItemRecalcular" Header="Recalcular cronograma" Command="{Binding RecalcularCronogramaCommand}" />
                    <Separator />
                    <!-- Bloco 25 (P3) -->
                    <MenuItem x:Name="ItemIrParaTarefa" Header="Ir para a tarefa…" Command="{Binding IrParaTarefaCommand}" />
                    <MenuItem Header="Rolar até a tarefa" Command="{Binding RolarAteTarefaCommand}"
                              ToolTip.Tip="Trazer a tarefa selecionada para a vista na grid e no Gantt" />
                    <Separator />
                    <!-- Sempre visível (Bloco 17): abre a galeria mesmo sem fotos, para adicionar a primeira. -->
                    <MenuItem x:Name="ItemFotos" Header="Gerenciar fotos…" Command="{Binding GerenciarFotosCommand}"
                              ToolTip.Tip="{Binding DicaGerenciarFotos}" ToolTip.ShowOnDisabled="True" />
                </MenuItem>
                <!-- Bloco 25 -->
                <MenuItem Header="Ajuda">
                    <MenuItem Header="Sobre o ProjectPlanner…" Command="{Binding SobreCommand}" />
                </MenuItem>
            </Menu>
        </Border>

        <!-- Linha 2, logo abaixo: a barra de acesso rápido (os comandos do dia a dia, a um clique). O zoom do
             Gantt fica no canto do próprio Gantt (Bloco 16). Os botões são só ícones; o nome vai na dica e no AutomationProperties.Name (que é o
             que os leitores de tela anunciam). Sem a ação disponível (CanExecute), o botão fica esmaecido. -->
        <Border DockPanel.Dock="Top" Padding="4,2" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <DockPanel>
                <StackPanel x:Name="AcessoRapido" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button Classes="acessoRapido" Command="{Binding SalvarProjetoCommand}" ToolTip.Tip="Salvar"
                            AutomationProperties.Name="Salvar">
                        <!-- Disquete -->
                        <Path Data="M2.5,1.5 H11 L14.5,5 V14.5 H1.5 V2.5 Z M4.5,1.5 V5.5 H10.5 V1.5 M4.5,14.5 V9.5 H11.5 V14.5" />
                    </Button>
                    <Border Classes="divisor" />
                    <Button Classes="acessoRapido" Command="{Binding AdicionarTarefaCommand}" ToolTip.Tip="Adicionar tarefa"
                            AutomationProperties.Name="Adicionar tarefa">
                        <!-- Barra de tarefa com um + -->
                        <Path Data="M1,6.5 H8.5 V9.5 H1 Z M12.5,4 V12 M8.5,8 H16" />
                    </Button>
                    <Button Classes="acessoRapido" Command="{Binding RemoverTarefaCommand}"
                            ToolTip.Tip="Remover tarefa (a selecionada)" AutomationProperties.Name="Remover tarefa">
                        <!-- Barra de tarefa com um − -->
                        <Path Data="M1,6.5 H8.5 V9.5 H1 Z M10,8 H15.5" />
                    </Button>
                    <Border Classes="divisor" />
                    <Button Classes="acessoRapido" Command="{Binding PromoverCommand}"
                            ToolTip.Tip="Promover: sobe a tarefa um nível (Alt+Shift+←)" AutomationProperties.Name="Promover">
                        <!-- Seta para a esquerda, com as linhas de um recuo -->
                        <Path Data="M15,8 H3.5 M7.5,4 L3.5,8 L7.5,12 M1,2 V14" />
                    </Button>
                    <Button Classes="acessoRapido" Command="{Binding RebaixarCommand}"
                            ToolTip.Tip="Rebaixar: desce a tarefa um nível, para dentro da de cima (Alt+Shift+→)"
                            AutomationProperties.Name="Rebaixar">
                        <!-- Seta para a direita, com a linha de um recuo -->
                        <Path Data="M1,2 V14 M4,8 H15 M11,4 L15,8 L11,12" />
                    </Button>
                    <Border Classes="divisor" />
                    <Button Classes="acessoRapido" Command="{Binding RecalcularCronogramaCommand}" ToolTip.Tip="Recalcular cronograma"
                            AutomationProperties.Name="Recalcular cronograma">
                        <!-- Setas em círculo -->
                        <Path Data="M13.5,8 A5.5,5.5 0 1 1 11.9,4.1 M12.2,1.2 L12,4.3 L8.9,4.2" />
                    </Button>
                    <Border Classes="divisor" />
                    <!-- Bloco 25 (F1): a galeria da tarefa selecionada, com quantas fotos ela tem; desabilitado sem seleção. -->
                    <Button x:Name="BotaoFotos" Classes="acessoRapido" Command="{Binding GerenciarFotosCommand}"
                            ToolTip.ShowOnDisabled="True" AutomationProperties.Name="Fotos da tarefa">
                        <!-- Câmera. O número de fotos vai por cima, num adorno (ver MainWindow.axaml.cs, ContadorDeFotos). -->
                        <Path Data="M1.5,5 A1,1 0 0 1 2.5,4 H5 L6.2,2.3 H9.8 L11,4 H13.5 A1,1 0 0 1 14.5,5 V12.5 A1,1 0 0 1 13.5,13.5 H2.5 A1,1 0 0 1 1.5,12.5 Z M8,6.2 A2.6,2.6 0 1 0 8,11.4 A2.6,2.6 0 1 0 8,6.2" />
                    </Button>
                    <Border Classes="divisor" />
                    <!-- Modos de visualização: o do modo atual fica marcado (classe ativo). -->
                    <Button Classes="acessoRapido" Classes.ativo="{Binding EhDividido}"
                            Command="{Binding DefinirModoVisualizacaoCommand}" CommandParameter="{x:Static vm:ModoVisualizacao.Dividido}"
                            ToolTip.Tip="Dividido: tabela e Gantt lado a lado" AutomationProperties.Name="Dividido">
                        <!-- Retângulo dividido ao meio -->
                        <Path Data="M1.5,2.5 H14.5 V13.5 H1.5 Z M7,2.5 V13.5" />
                    </Button>
                    <Button Classes="acessoRapido" Classes.ativo="{Binding EhSomenteTabela}"
                            Command="{Binding DefinirModoVisualizacaoCommand}" CommandParameter="{x:Static vm:ModoVisualizacao.SomenteTabela}"
                            ToolTip.Tip="Somente Tabela: a grid de tarefas na largura toda" AutomationProperties.Name="Somente Tabela">
                        <!-- Tabela -->
                        <Path Data="M1.5,2.5 H14.5 V13.5 H1.5 Z M1.5,6 H14.5 M1.5,9.75 H14.5 M5.5,2.5 V13.5" />
                    </Button>
                    <Button Classes="acessoRapido" Classes.ativo="{Binding EhSomenteGantt}"
                            Command="{Binding DefinirModoVisualizacaoCommand}" CommandParameter="{x:Static vm:ModoVisualizacao.SomenteGantt}"
                            ToolTip.Tip="Somente Gantt: o Gantt na largura toda" AutomationProperties.Name="Somente Gantt">
                        <!-- Barras em escada -->
                        <Path Data="M1.5,3.5 H7 M5,8 H11 M9.5,12.5 H14.5" StrokeThickness="2.4" />
                    </Button>
                    <Border Classes="divisor" />
                    <Button Classes="acessoRapido" Classes.ativo="{Binding Assistente.Visivel}"
                            Command="{Binding Assistente.AlternarVisibilidadeCommand}"
                            ToolTip.Tip="Assistente (IA): mostrar ou ocultar o painel" AutomationProperties.Name="Assistente">
                        <!-- Balão de conversa -->
                        <Path Data="M2,3.5 A1.5,1.5 0 0 1 3.5,2 H12.5 A1.5,1.5 0 0 1 14,3.5 V9.5 A1.5,1.5 0 0 1 12.5,11 H7 L4,14 V11 H3.5 A1.5,1.5 0 0 1 2,9.5 Z M5,5.5 H11 M5,8 H9" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Dados do projeto -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="8">
            <TextBlock Text="Projeto:" VerticalAlignment="Center" />
            <TextBox Width="320" Text="{Binding NomeProjeto, UpdateSourceTrigger=LostFocus}" />
            <TextBlock Text="Início:" VerticalAlignment="Center" Margin="12,0,0,0" />
            <CalendarDatePicker SelectedDate="{Binding InicioProjeto}" />
            <TextBlock Text="Término:" VerticalAlignment="Center" Margin="12,0,0,0" />
            <TextBlock Text="{Binding TerminoProjeto, StringFormat={}{0:d}}" VerticalAlignment="Center" FontWeight="SemiBold" />
        </StackPanel>

        <!-- Barra de status: a mensagem à esquerda; à direita (Bloco 25, V1), o projeto, a selecionada e a versão. -->
        <Border DockPanel.Dock="Bottom" Padding="8,4" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <DockPanel>
                <StackPanel x:Name="InformacoesDaBarra" DockPanel.Dock="Right" Orientation="Horizontal" Spacing="14" Margin="12,0,0,0">
                    <StackPanel.Styles>
                        <Style Selector="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </StackPanel.Styles>
                    <TextBlock x:Name="StatusSelecionada" Text="{Binding TextoSelecionadaNaBarra}" MaxWidth="320"
                               TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding TextoSelecionadaNaBarra, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock x:Name="StatusTarefas" Text="{Binding TextoTarefasNaBarra}" />
                    <TextBlock x:Name="StatusPeriodo" Text="{Binding TextoPeriodoNaBarra}"
                               IsVisible="{Binding TextoPeriodoNaBarra, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock x:Name="StatusVersao" Text="{Binding TextoVersaoNaBarra}" />
                </StackPanel>
                <TextBlock x:Name="StatusMensagem" Text="{Binding MensagemNaBarra}" ToolTip.Tip="{Binding Mensagem}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Grid à esquerda e Gantt à direita, com divisor arrastável. As linhas e o cabeçalho dos dois
             têm a mesma altura (GanttViewModel.AlturaLinha e AlturaCabecalho), e a grid comanda a
             rolagem vertical do Gantt (ver MainWindow.axaml.cs). -->
        <!-- Os modos de visualização (MainWindowViewModel.ModoVisualizacao) mudam só as larguras e a visibilidade
             destas colunas (ver AplicarModoVisualizacao no MainWindow.axaml.cs). -->
        <Grid x:Name="Paineis" ColumnDefinitions="620,6,*,0,0" Margin="8,0,8,8">
        <!-- Grid de tarefas. Nº, Predecessoras editáveis na notação "2; 3II+2" (ver NotacaoPredecessoras). -->
        <DataGrid x:Name="Grade"
                  Grid.Column="0"
                  RowHeight="{x:Static vm:GanttViewModel.AlturaLinhaDaGrade}"
                  ColumnHeaderHeight="{x:Static vm:GanttViewModel.AlturaCabecalho}"
                  ItemsSource="{Binding LinhasVisiveis}"
                  SelectedItem="{Binding TarefaSelecionada}"
                  SelectionMode="Single"
                  CellEditEnded="GradeCellEditEnded"
                  BeginningEdit="GradeBeginningEdit"
                  AutoGenerateColumns="False"
                  CanUserSortColumns="False"
                  CanUserReorderColumns="True"
                  CanUserResizeColumns="True"
                  GridLinesVisibility="All"
                  Classes.semSelecao="{Binding !MostrarSelecao}"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <!-- Menu de contexto (Bloco 17): o clique direito numa linha a seleciona (ver PedirMenuDaGrade). -->
            <DataGrid.ContextMenu>
                <ContextMenu x:Name="MenuDaGrade">
                    <!-- O clique direito seleciona a linha antes; nas linhas vazias não há menu (PedirMenuDaGrade). -->
                    <MenuItem Header="Inserir tarefa acima" Command="{Binding InserirTarefaAcimaCommand}" />
                    <MenuItem Header="Inserir tarefa abaixo" Command="{Binding InserirTarefaAbaixoCommand}" />
                    <Separator />
                    <MenuItem Header="Gerenciar fotos…" Command="{Binding GerenciarFotosCommand}" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Styles>
                <Style Selector="DataGridCell">
                    <Setter Property="FontSize" Value="13" />
                </Style>
                <!-- Seleção sutil: em vez do fundo azul do tema, um contorno cinza-azulado de 2 px desenhado
                     no retângulo de fundo da linha (não muda a altura, que precisa bater com o Gantt).
                     A mesma cor contorna a linha no Gantt (GanttChartView). -->
                <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
                    <Setter Property="Fill" Value="Transparent" />
                    <Setter Property="Stroke" Value="#6A8CAF" />
                    <Setter Property="StrokeThickness" Value="2" />
                    <Setter Property="Opacity" Value="1" />
                </Style>
                <!-- "Mostrar seleção" desligado: nenhum destaque na linha nem na célula atual. A seleção
                     continua existindo (Remover tarefa, edição inline). -->
                <Style Selector="DataGrid.semSelecao DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
                    <Setter Property="Opacity" Value="0" />
                </Style>
                <Style Selector="DataGrid.semSelecao DataGridCell /template/ Grid#FocusVisual">
                    <Setter Property="IsVisible" Value="False" />
                </Style>
                <Style Selector="DataGridRow" x:DataType="vm:TarefaViewModel">
                    <Setter Property="Background"
                            Value="{Binding DestacarComoCritica, Converter={x:Static v:Conversores.FundoDaTarefaCritica}}" />
                    <Setter Property="FontWeight"
                            Value="{Binding EhResumo, Converter={x:Static v:Conversores.NegritoSeVerdadeiro}}" />
                    <Setter Property="Opacity"
                            Value="{Binding SendoArrastada, Converter={x:Static v:Conversores.MeiaOpacidadeSeVerdadeiro}}" />
                </Style>
            </DataGrid.Styles>

            <DataGrid.Columns>
                <DataGridTextColumn x:DataType="vm:TarefaViewModel" Tag="Numero" Header="Nº" Width="65" Binding="{Binding Numero}" IsReadOnly="True" />
                <!-- EDT: por enquanto igual ao Nº; fica hierárquica quando houver tarefas-resumo (Bloco 11). -->
                <DataGridTextColumn x:DataType="vm:TarefaViewModel" Tag="Edt" Header="EDT" Width="75" Binding="{Binding Edt}" IsReadOnly="True" />
                <!-- Nome recuado pelo nível, com ▾/▸ nos resumos e ◆ nos marcos (ver ColunaNomeDaTarefa). -->
                <v:ColunaNomeDaTarefa x:DataType="vm:TarefaViewModel" Tag="Nome" Header="Nome" Binding="{Binding Nome}" Width="220" />
                <DataGridTextColumn x:DataType="vm:TarefaViewModel" Tag="Duracao" Header="Duração&#x0a;(dias)" Width="104" Binding="{Binding Duracao}" />

                <DataGridTemplateColumn x:DataType="vm:TarefaViewModel" Tag="Inicio" Header="Início" Width="104">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:TarefaViewModel">
                            <TextBlock Text="{Binding DataInicio, StringFormat={}{0:d}}" VerticalAlignment="Center" Margin="12,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate x:DataType="vm:TarefaViewModel">
                            <CalendarDatePicker SelectedDate="{Binding DataInicio}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn x:DataType="vm:TarefaViewModel" Tag="Termino" Header="Término" Width="104">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:TarefaViewModel">
                            <TextBlock Text="{Binding DataTermino, StringFormat={}{0:d}}" VerticalAlignment="Center" Margin="12,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate x:DataType="vm:TarefaViewModel">
                            <CalendarDatePicker SelectedDate="{Binding DataTermino}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn x:DataType="vm:TarefaViewModel" Tag="PercentualConcluido" Header="%&#x0a;Concl." Width="80" Binding="{Binding PercentualConcluido}" />
                <DataGridTextColumn x:DataType="vm:TarefaViewModel" Tag="Predecessoras" Header="Predecessoras" Binding="{Binding Predecessoras}" Width="130" />
                <DataGridTextColumn x:DataType="vm:TarefaViewModel" Tag="Sucessoras" Header="Sucessoras" Binding="{Binding Sucessoras}" Width="130" IsReadOnly="True" />

                <DataGridTextColumn x:DataType="vm:TarefaViewModel" Tag="InicioMaisCedo" Header="Início&#x0a;cedo" Width="104" Binding="{Binding InicioMaisCedo, StringFormat={}{0:d}}" IsReadOnly="True" />
                <DataGridTextColumn x:DataType="vm:TarefaViewModel" Tag="TerminoMaisCedo" Header="Término&#x0a;cedo" Width="104" Binding="{Binding TerminoMaisCedo, StringFormat={}{0:d}}" IsReadOnly="True" />
                <DataGridTextColumn x:DataType="vm:TarefaViewModel" Tag="InicioMaisTarde" Header="Início&#x0a;tarde" Width="104" Binding="{Binding InicioMaisTarde, StringFormat={}{0:d}}" IsReadOnly="True" />
                <DataGridTextColumn x:DataType="vm:TarefaViewModel" Tag="TerminoMaisTarde" Header="Término&#x0a;tarde" Width="104" Binding="{Binding TerminoMaisTarde, StringFormat={}{0:d}}" IsReadOnly="True" />
                <DataGridTextColumn x:DataType="vm:TarefaViewModel" Tag="Folga" Header="Folga&#x0a;(dias)" Width="85" Binding="{Binding Folga}" IsReadOnly="True" />
                <DataGridTextColumn x:DataType="vm:TarefaViewModel" Tag="Critica" Header="Crítica" Width="90"
                                    Binding="{Binding EhCritica, Converter={x:Static v:Conversores.SimOuVazio}}" IsReadOnly="True" />
                <DataGridTextColumn x:DataType="vm:TarefaViewModel" Tag="Notas" Header="Notas" Binding="{Binding Notas}" Width="200" />
            </DataGrid.Columns>
        </DataGrid>
        <!-- Linhas vazias abaixo das tarefas, até o fim da área visível: só desenho, sem receber o mouse. -->
        <v:LinhasVaziasDaGrade x:Name="LinhasVazias" Grid.Column="0" IsHitTestVisible="False" />
        <!-- Guia do arraste de tarefas (Bloco 18): onde a tarefa arrastada pela coluna Nº vai cair. -->
        <v:GuiaDeReordenacao x:Name="GuiaDeArraste" Grid.Column="0" IsHitTestVisible="False" />

        <GridSplitter x:Name="Divisor" Grid.Column="1" ResizeDirection="Columns" Background="Transparent" />

        <Panel x:Name="PainelGantt" Grid.Column="2">
            <Border BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                <v:GanttChartView x:Name="Gantt" DataContext="{Binding Gantt}" />
            </Border>
            <!-- Zoom flutuante no canto inferior direito do Gantt, acima da barra de rolagem horizontal, com fundo
                 semitransparente para ficar legível sobre as barras. − e + mudam 5 px/dia; o slider, livremente. -->
            <Border x:Name="ControleDeZoom" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,20"
                    Background="#E6FFFFFF" BorderBrush="#33000000" BorderThickness="1" CornerRadius="16"
                    Padding="4,0" BoxShadow="0 1 4 0 #26000000">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button Classes="zoom" Content="−" Command="{Binding Gantt.DiminuirZoomCommand}"
                            ToolTip.Tip="Diminuir o zoom (5 px/dia)" AutomationProperties.Name="Diminuir zoom" />
                    <Slider x:Name="Zoom" Width="90" VerticalAlignment="Center"
                            Minimum="{x:Static vm:GanttViewModel.EscalaMinima}"
                            Maximum="{x:Static vm:GanttViewModel.EscalaMaxima}"
                            Value="{Binding Gantt.PixelsPorDia}" ToolTip.Tip="Zoom do Gantt" />
                    <Button Classes="zoom" Content="+" Command="{Binding Gantt.AumentarZoomCommand}"
                            ToolTip.Tip="Aumentar o zoom (5 px/dia)" AutomationProperties.Name="Aumentar zoom" />
                    <TextBlock Text="{Binding Gantt.PixelsPorDia, StringFormat={}{0:0} px/dia}" VerticalAlignment="Center"
                               MinWidth="58" Margin="4,0,6,0" FontSize="12" />
                    <!-- Bloco 25 (P8) -->
                    <Button Classes="zoom" Content="⤢" FontSize="14" Command="{Binding Gantt.AjustarAoProjetoCommand}"
                            ToolTip.Tip="Ajustar ao projeto: o projeto inteiro na largura do Gantt" AutomationProperties.Name="Ajustar ao projeto" />
                    <Button Classes="zoom" Content="◉" FontSize="12" Command="{Binding Gantt.IrParaHojeCommand}" Margin="0,0,4,0"
                            ToolTip.Tip="Ir para hoje" AutomationProperties.Name="Ir para hoje" />
                </StackPanel>
            </Border>
        </Panel>

        <!-- Painel do assistente de IA (Bloco 19), à direita, em qualquer modo de visualização. As colunas 3 e 4
             só ganham largura quando ele está visível (ver AplicarPainelDoAssistente). -->
        <GridSplitter x:Name="DivisorDoAssistente" Grid.Column="3" ResizeDirection="Columns" Background="Transparent" />
        <v:AssistenteView x:Name="PainelAssistente" Grid.Column="4" DataContext="{Binding Assistente}" />
        </Grid>
    </DockPanel>
</Window>
