<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ProjectPlanner.App.ViewModels"
        xmlns:v="using:ProjectPlanner.App.Views"
        x:Class="ProjectPlanner.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding Titulo}"
        Width="1340" Height="700" MinWidth="900" MinHeight="400">

    <DockPanel>
        <!-- Barra de ferramentas -->
        <Border DockPanel.Dock="Top" Padding="8" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="Novo" Command="{Binding NovoProjetoCommand}" />
                <Button Content="Abrir…" Command="{Binding AbrirProjetoCommand}" />
                <Button Content="Salvar" Command="{Binding SalvarProjetoCommand}" />
                <Border Width="1" Margin="6,2" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />
                <Button Content="Adicionar tarefa" Command="{Binding AdicionarTarefaCommand}" />
                <Button Content="Remover tarefa" Command="{Binding RemoverTarefaCommand}" />
                <Border Width="1" Margin="6,2" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />
                <Button Content="Recalcular cronograma" Command="{Binding RecalcularCronogramaCommand}" />
            </StackPanel>
        </Border>

        <!-- Dados do projeto -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="8">
            <TextBlock Text="Projeto:" VerticalAlignment="Center" />
            <TextBox Width="320" Text="{Binding NomeProjeto, UpdateSourceTrigger=LostFocus}" />
            <TextBlock Text="Início:" VerticalAlignment="Center" Margin="12,0,0,0" />
            <CalendarDatePicker SelectedDate="{Binding InicioProjeto}" />
            <TextBlock Text="Término:" VerticalAlignment="Center" Margin="12,0,0,0" />
            <TextBlock Text="{Binding TerminoProjeto, StringFormat={}{0:d}}" VerticalAlignment="Center" FontWeight="SemiBold" />
        </StackPanel>

        <!-- Barra de status -->
        <Border DockPanel.Dock="Bottom" Padding="8,4" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <TextBlock Text="{Binding Mensagem}" TextTrimming="CharacterEllipsis" />
        </Border>

        <!-- Grid de tarefas. Nº, Predecessoras editáveis na notação "2; 3II+2" (ver NotacaoPredecessoras). -->
        <DataGrid ItemsSource="{Binding Tarefas}"
                  SelectedItem="{Binding TarefaSelecionada}"
                  SelectionMode="Single"
                  CellEditEnded="GradeCellEditEnded"
                  AutoGenerateColumns="False"
                  CanUserSortColumns="False"
                  CanUserReorderColumns="False"
                  GridLinesVisibility="All"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                  Margin="8,0,8,8">
            <DataGrid.Styles>
                <Style Selector="DataGridCell">
                    <Setter Property="FontSize" Value="13" />
                </Style>
                <Style Selector="DataGridRow" x:DataType="vm:TarefaViewModel">
                    <Setter Property="Background"
                            Value="{Binding EhCritica, Converter={x:Static v:Conversores.FundoDaTarefaCritica}}" />
                </Style>
            </DataGrid.Styles>

            <DataGrid.Columns>
                <DataGridTextColumn x:DataType="vm:TarefaViewModel" Header="Nº" Width="65" Binding="{Binding Numero}" IsReadOnly="True" />
                <DataGridTextColumn x:DataType="vm:TarefaViewModel" Header="Nome" Binding="{Binding Nome}" Width="130" />
                <DataGridTextColumn x:DataType="vm:TarefaViewModel" Header="Duração&#x0a;(dias)" Width="104" Binding="{Binding Duracao}" />

                <DataGridTemplateColumn x:DataType="vm:TarefaViewModel" Header="Início" Width="104">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:TarefaViewModel">
                            <TextBlock Text="{Binding DataInicio, StringFormat={}{0:d}}" VerticalAlignment="Center" Margin="12,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate x:DataType="vm:TarefaViewModel">
                            <CalendarDatePicker SelectedDate="{Binding DataInicio}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn x:DataType="vm:TarefaViewModel" Header="Término" Width="104">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:TarefaViewModel">
                            <TextBlock Text="{Binding DataTermino, StringFormat={}{0:d}}" VerticalAlignment="Center" Margin="12,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate x:DataType="vm:TarefaViewModel">
                            <CalendarDatePicker SelectedDate="{Binding DataTermino}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn x:DataType="vm:TarefaViewModel" Header="%&#x0a;Concl." Width="80" Binding="{Binding PercentualConcluido}" />
                <DataGridTextColumn x:DataType="vm:TarefaViewModel" Header="Predecessoras" Binding="{Binding Predecessoras}" Width="130" />

                <DataGridTextColumn x:DataType="vm:TarefaViewModel" Header="Início&#x0a;cedo" Width="104" Binding="{Binding InicioMaisCedo, StringFormat={}{0:d}}" IsReadOnly="True" />
                <DataGridTextColumn x:DataType="vm:TarefaViewModel" Header="Término&#x0a;cedo" Width="104" Binding="{Binding TerminoMaisCedo, StringFormat={}{0:d}}" IsReadOnly="True" />
                <DataGridTextColumn x:DataType="vm:TarefaViewModel" Header="Início&#x0a;tarde" Width="104" Binding="{Binding InicioMaisTarde, StringFormat={}{0:d}}" IsReadOnly="True" />
                <DataGridTextColumn x:DataType="vm:TarefaViewModel" Header="Término&#x0a;tarde" Width="104" Binding="{Binding TerminoMaisTarde, StringFormat={}{0:d}}" IsReadOnly="True" />
                <DataGridTextColumn x:DataType="vm:TarefaViewModel" Header="Folga&#x0a;(dias)" Width="85" Binding="{Binding Folga}" IsReadOnly="True" />
                <DataGridTextColumn x:DataType="vm:TarefaViewModel" Header="Crítica" Width="90"
                                    Binding="{Binding EhCritica, Converter={x:Static v:Conversores.SimOuVazio}}" IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
