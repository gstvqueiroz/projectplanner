<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ProjectPlanner.App.ViewModels"
        x:Class="ProjectPlanner.App.Views.OrcamentoWindow"
        x:DataType="vm:OrcamentoViewModel"
        Title="{Binding Titulo}"
        Width="1180" Height="740" MinWidth="900" MinHeight="540"
        WindowStartupLocation="CenterOwner">

    <!-- Bloco 33: planilha orçamentária, composições e bases de preços (SINAPI). -->
    <Window.Styles>
        <Style Selector="TextBlock.secao">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style Selector="TextBlock.forte">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Padding" Value="6,2,-26,2" /> <!-- sem ordenação: o espaço da seta fica para o título -->
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="DataGridCell">
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Styles>

    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Fechar" Click="Fechar" IsCancel="True" />
            <ProgressBar DockPanel.Dock="Right" IsIndeterminate="True" IsVisible="{Binding Ocupado}" Width="120" Margin="0,0,12,0" />
            <TextBlock x:Name="Mensagem" Text="{Binding Mensagem}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12" Margin="0,0,12,0" />
        </DockPanel>

        <TabControl x:Name="Abas" SelectedIndex="{Binding AbaEscolhida}">
            <!-- ===== Planilha ===== -->
            <TabItem Header="Planilha">
                <DockPanel Margin="0,8,0,0">
                    <WrapPanel DockPanel.Dock="Top" ItemSpacing="8" LineSpacing="6" Margin="0,0,0,6">
                        <TextBlock Text="BDI (%)" VerticalAlignment="Center" />
                        <TextBox x:Name="Bdi" Text="{Binding Bdi}" Width="70"
                                 ToolTip.Tip="Sobre o custo direto (os encargos sociais já estão nos preços da SINAPI)" />
                        <TextBlock Text="BDI de materiais (%)" VerticalAlignment="Center" Margin="8,0,0,0" />
                        <TextBox x:Name="BdiDeMateriais" Text="{Binding BdiDeMateriais}" Width="70" PlaceholderText="igual"
                                 ToolTip.Tip="Opcional: um BDI diferenciado para os materiais (em branco, vale o BDI acima para tudo)" />
                        <Button x:Name="SalvarBdi" Content="Guardar BDI" Command="{Binding SalvarBdiCommand}" />
                        <Button x:Name="Aplicar" Classes="accent" Content="Aplicar aos valores e recursos…" Command="{Binding AplicarCommand}" Margin="16,0,0,0"
                                ToolTip.Tip="O total de cada serviço vai para o Valor da tarefa e os insumos viram recursos atribuídos a ela" />
                        <Button Content="PDF…" Command="{Binding ExportarPdfCommand}" Margin="16,0,0,0" />
                        <Button Content="Word…" Command="{Binding ExportarWordCommand}" />
                        <Button Content="Excel…" Command="{Binding ExportarExcelCommand}" />
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{x:Static vm:OrcamentoViewModel.TextoSemServicos}" IsVisible="{Binding SemServicos}"
                               TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,6" />
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Totais}" Width="420">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:LinhaDoResumoNaTela">
                                    <DockPanel Margin="0,2">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Valor}" Classes.forte="{Binding Destaque}" Margin="16,0,0,0" />
                                        <TextBlock Text="{Binding Rotulo}" Classes.forte="{Binding Destaque}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding BasesUsadas}" TextWrapping="Wrap" FontSize="12" Opacity="0.75" VerticalAlignment="Bottom" />
                    </DockPanel>
                    <DataGrid x:Name="Planilha" ItemsSource="{Binding Linhas}" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="False"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="EDT" Binding="{Binding Edt}" Width="60" />
                            <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="*" />
                            <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="80" />
                            <DataGridTextColumn Header="Fonte" Binding="{Binding Fonte}" Width="115" />
                            <DataGridTextColumn Header="Unid." Binding="{Binding Unidade}" Width="55" />
                            <DataGridTextColumn Header="Quant." Binding="{Binding Quantidade}" Width="75" />
                            <DataGridTextColumn Header="Custo unit." Binding="{Binding CustoUnitario}" Width="95" />
                            <DataGridTextColumn Header="Preço unit. c/ BDI" Binding="{Binding PrecoUnitario}" Width="125" />
                            <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ===== Composições ===== -->
            <TabItem Header="Composições">
                <Grid RowDefinitions="*,Auto,*" Margin="0,8,0,0">
                    <DockPanel Grid.Row="0">
                        <WrapPanel DockPanel.Dock="Top" ItemSpacing="8" LineSpacing="6" Margin="0,0,0,6">
                            <TextBlock Text="Base" VerticalAlignment="Center" />
                            <ComboBox x:Name="Base" ItemsSource="{Binding Bases}" SelectedItem="{Binding BaseEscolhida}" MinWidth="280"
                                      PlaceholderText="importe uma base na aba Bases" />
                            <TextBlock Text="Buscar" VerticalAlignment="Center" Margin="8,0,0,0" />
                            <TextBox x:Name="Busca" Text="{Binding Busca}" Width="300" PlaceholderText="código ou palavras da descrição" />
                        </WrapPanel>
                        <DataGrid x:Name="Resultados" ItemsSource="{Binding Resultados}" SelectedItem="{Binding ResultadoEscolhido}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="False" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="80" />
                                <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="*" />
                                <DataGridTextColumn Header="Unid." Binding="{Binding Unidade}" Width="55" />
                                <DataGridTextColumn Header="Custo unit." Binding="{Binding Custo}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                    <WrapPanel Grid.Row="1" ItemSpacing="8" LineSpacing="6" Margin="0,8">
                        <TextBlock Text="Tarefa" VerticalAlignment="Center" />
                        <ComboBox x:Name="Tarefa" ItemsSource="{Binding Tarefas}" SelectedItem="{Binding TarefaEscolhida}" MinWidth="420" />
                        <Button x:Name="Usar" Classes="accent" Content="Usar na tarefa" Command="{Binding UsarCommand}"
                                ToolTip.Tip="A composição escolhida acima passa a ser a da tarefa (a quantidade vem da coluna Quantidade)" />
                        <Button x:Name="Tirar" Content="Tirar" Command="{Binding TirarCommand}" />
                    </WrapPanel>
                    <DockPanel Grid.Row="2">
                        <TextBlock DockPanel.Dock="Top" Text="{Binding TextoDaComposicao}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,6" />
                        <DataGrid x:Name="Insumos" ItemsSource="{Binding InsumosDaTarefa}" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserSortColumns="False" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="80" />
                                <DataGridTextColumn Header="Insumo" Binding="{Binding Descricao}" Width="*" />
                                <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="110" />
                                <DataGridTextColumn Header="Unid." Binding="{Binding Unidade}" Width="55" />
                                <DataGridTextColumn Header="Coeficiente" Binding="{Binding Coeficiente}" Width="95" />
                                <DataGridTextColumn Header="Preço" Binding="{Binding Preco}" Width="90" />
                                <DataGridTextColumn Header="Parcial" Binding="{Binding Parcial}" Width="90" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ===== Bases ===== -->
            <TabItem Header="Bases">
                <DockPanel Margin="0,8,0,0">
                    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
                        <TextBlock Classes="secao" Text="Baixar a SINAPI ou importar uma planilha de preços" />
                        <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8"
                                   Text="Baixar da Caixa: o programa busca a SINAPI mais recente no site da Caixa (uns 16 MB) e monta a base do estado (UF) e da desoneração escolhidos, com os insumos e as composições." />
                        <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8"
                                   Text="A planilha de insumos (código, descrição, unidade, preço) e a de composições analíticas (código da composição, tipo e código do item, coeficiente) vão para a mesma base: importe as duas. A UF, a referência e a desoneração vêm do nome do arquivo quando ele as traz (por exemplo SINAPI_Custo_Ref_Insumos_SP_202609_Desonerado.xlsx). Só a primeira aba de um .xlsx é lida." />
                        <WrapPanel ItemSpacing="8" LineSpacing="6">
                            <TextBlock Text="Fonte" VerticalAlignment="Center" />
                            <TextBox x:Name="Fonte" Text="{Binding Fonte}" Width="110" />
                            <TextBlock Text="UF" VerticalAlignment="Center" Margin="8,0,0,0" />
                            <TextBox x:Name="Uf" Text="{Binding Uf}" Width="50" />
                            <TextBlock Text="Referência" VerticalAlignment="Center" Margin="8,0,0,0" />
                            <TextBox x:Name="Referencia" Text="{Binding Referencia}" Width="90" PlaceholderText="09/2026" />
                            <ComboBox x:Name="Desoneracao" ItemsSource="{Binding OpcoesDeDesoneracao}" SelectedItem="{Binding DesoneradoEscolhido}" Margin="8,0,0,0" />
                            <Button x:Name="BaixarSinapi" Classes="accent" Content="Baixar da Caixa" Command="{Binding BaixarSinapiCommand}" Margin="8,0,0,0"
                                    ToolTip.Tip="Baixa a SINAPI mais recente do site da Caixa para a UF e a desoneração escolhidas" />
                            <Button x:Name="Importar" Content="Importar planilha…" Command="{Binding ImportarPlanilhaCommand}" />
                        </WrapPanel>
                    </StackPanel>
                    <WrapPanel DockPanel.Dock="Bottom" ItemSpacing="8" Margin="0,8,0,0">
                        <Button x:Name="AtualizarPrecos" Content="Atualizar os preços do orçamento por esta base…" Command="{Binding AtualizarPrecosCommand}"
                                ToolTip.Tip="Troca as composições do orçamento pelas de mesmo código nesta base (outro mês ou outro estado)" />
                        <Button x:Name="RemoverBase" Content="Remover base…" Command="{Binding RemoverBaseCommand}" />
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Nenhuma base importada ainda." IsVisible="{Binding SemBases}" Opacity="0.7" Margin="0,0,0,6" />
                    <DataGrid x:Name="ListaDeBases" ItemsSource="{Binding BasesNaBiblioteca}" SelectedItem="{Binding BaseNaLista}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="False" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Base" Binding="{Binding Base.Descricao}" Width="*" />
                            <DataGridTextColumn Header="Insumos" Binding="{Binding Insumos}" Width="100" />
                            <DataGridTextColumn Header="Composições" Binding="{Binding Composicoes}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <!-- ===== Sugestões da IA (Bloco 38) ===== -->
            <TabItem Header="Sugestões da IA">
                <DockPanel Margin="0,8,0,0">
                    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
                        <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8" Text="{Binding BaseDasSugestoes}" />
                        <WrapPanel ItemSpacing="12" LineSpacing="6">
                            <CheckBox x:Name="PedirComposicoes" Content="Composições e preços" IsChecked="{Binding PedirComposicoes}"
                                      ToolTip.Tip="A composição da base para cada tarefa; sem uma adequada, um preço estimado pela IA" />
                            <CheckBox x:Name="PedirQuantidades" Content="Quantidades" IsChecked="{Binding PedirQuantidades}"
                                      ToolTip.Tip="Estimadas pela ficha da obra (área, pavimentos…) e pelas notas, com a conta na justificativa" />
                            <CheckBox x:Name="PedirRevisao" Content="Revisão e BDI" IsChecked="{Binding PedirRevisao}"
                                      ToolTip.Tip="Serviços que parecem faltar, unidades incoerentes, quantidades fora do padrão e o BDI" />
                            <CheckBox x:Name="PedirEquipes" Content="Equipes e durações" IsChecked="{Binding PedirEquipes}"
                                      ToolTip.Tip="Quantos profissionais e equipamentos por dia, e durações coerentes com as horas das composições" />
                        </WrapPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0">
                                <Button x:Name="Pedir" Classes="accent" Content="Pedir sugestões" Command="{Binding PedirSugestoesCommand}" />
                                <Button x:Name="Cancelar" Content="Cancelar" Command="{Binding CancelarConsultaCommand}" IsVisible="{Binding Consultando}" />
                            </StackPanel>
                            <TextBox x:Name="Foco" Text="{Binding Foco}" PlaceholderText="Foco (opcional): por exemplo, só as vedações; ou a casa tem 120 m² em dois pavimentos" />
                        </DockPanel>
                        <ProgressBar IsIndeterminate="True" IsVisible="{Binding Consultando}" />
                        <TextBlock x:Name="TextoDaConsulta" Text="{Binding TextoDaConsulta}" TextWrapping="Wrap" FontSize="12" />
                    </StackPanel>
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Button x:Name="AplicarSugestoes" DockPanel.Dock="Right" Classes="accent" Content="Aplicar marcadas" Command="{Binding AplicarSugestoesCommand}"
                                ToolTip.Tip="As marcadas entram no projeto num passo só do Desfazer" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Marcar todas" Command="{Binding MarcarTodasCommand}" />
                            <Button Content="Desmarcar" Command="{Binding DesmarcarTodasCommand}" />
                            <TextBlock VerticalAlignment="Center" FontSize="12" Opacity="0.7" Margin="8,0,0,0"
                                       Text="Os preços das composições são sempre os da base; &quot;Estimativa IA&quot; e &quot;≈&quot; marcam o que a IA estimou." />
                        </StackPanel>
                    </DockPanel>
                    <DataGrid x:Name="ListaDeSugestoes" ItemsSource="{Binding Sugestoes}" AutoGenerateColumns="False" CanUserSortColumns="False"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="34">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:SugestaoNaTela">
                                        <CheckBox IsChecked="{Binding Aceita}" IsEnabled="{Binding PodeAceitar}" IsVisible="{Binding !EhAlerta}"
                                                  HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Tipo" Binding="{Binding Grupo}" Width="100" IsReadOnly="True" />
                            <DataGridTextColumn Header="Tarefa ou recurso" Binding="{Binding Alvo}" Width="230" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="Sugestão" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:SugestaoNaTela">
                                        <StackPanel Margin="4,3" Spacing="1">
                                            <TextBlock Text="{Binding Texto}" TextWrapping="Wrap" FontSize="12" />
                                            <TextBlock Text="{Binding Justificativa}" TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                                                       IsVisible="{Binding Justificativa, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            <TextBlock Text="{Binding Motivo, StringFormat='Não dá para aplicar: {0}'}" TextWrapping="Wrap" FontSize="11"
                                                       Foreground="{DynamicResource TextoDeErro}" IsVisible="{Binding Motivo, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
