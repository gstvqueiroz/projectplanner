<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ProjectPlanner.App.ViewModels"
        x:Class="ProjectPlanner.App.Views.OrdensDeServicoWindow"
        x:DataType="vm:OrdensDeServicoViewModel"
        Title="{Binding Titulo}"
        Width="1240" Height="800" MinWidth="960" MinHeight="560"
        WindowStartupLocation="CenterOwner">

    <!-- Bloco 58: a lista das OS à esquerda; a ficha da escolhida (dados, itens, tarefas, verificação, histórico) à direita. -->
    <Window.Styles>
        <Style Selector="TextBlock.secao">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
        <Style Selector="TextBlock.rotulo">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBlock.cabecalhoDosItens">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.7" />
        </Style>
    </Window.Styles>

    <DockPanel Margin="16">
        <!-- Mensagem e fechar -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Fechar" Click="Fechar" IsCancel="True" />
            <TextBlock x:Name="Mensagem" Text="{Binding Mensagem}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12" Margin="0,0,12,0" />
        </DockPanel>

        <!-- A lista -->
        <DockPanel DockPanel.Dock="Left" Width="330" Margin="0,0,16,0">
            <StackPanel DockPanel.Dock="Top" Spacing="6">
                <Button x:Name="NovaOrdem" Classes="accent" Content="Nova OS" Command="{Binding NovaOrdemCommand}" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        ToolTip.Tip="Uma OS em rascunho com a tarefa (ou a etapa) selecionada na grid: itens, quantidades, preços e datas vêm do cronograma" />
                <ComboBox x:Name="Filtro" ItemsSource="{Binding Filtros}" SelectedItem="{Binding FiltroEscolhido}" HorizontalAlignment="Stretch" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0">
                <TextBlock x:Name="Resumo" Text="{Binding Resumo}" TextWrapping="Wrap" FontSize="12" />
                <TextBlock x:Name="Prazos" Text="{Binding Prazos}" TextWrapping="Wrap" FontSize="12"
                           IsVisible="{Binding Prazos, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <!-- Bloco 60 -->
                <Expander Header="Por executante" HorizontalAlignment="Stretch" IsVisible="{Binding !SemOrdens}">
                    <ItemsControl x:Name="PorExecutante" ItemsSource="{Binding PorExecutante}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LinhaDoResumoNaTela">
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="{Binding Rotulo}" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Valor}" FontSize="11" Opacity="0.75" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
                <Button x:Name="ExportarCsv" Content="Exportar a lista (CSV)…" Command="{Binding ExportarCsvCommand}" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" IsVisible="{Binding !SemOrdens}" />
                <!-- Bloco 64 -->
                <Button x:Name="Relatorio" Content="Relatório das OS…" Click="AbrirRelatorio" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" IsVisible="{Binding !SemOrdens}"
                        ToolTip.Tip="O relatório em PDF: números, vencidas, para conferir, por executante e a lista, com filtro por período" />
            </StackPanel>
            <Panel Margin="0,8,0,0">
                <TextBlock Text="{x:Static vm:OrdensDeServicoViewModel.TextoSemOrdens}" TextWrapping="Wrap" Opacity="0.7" IsVisible="{Binding SemOrdens}" />
                <ListBox x:Name="Lista" ItemsSource="{Binding Lista}" SelectedItem="{Binding Selecionada}" IsVisible="{Binding !SemOrdens}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:OrdemNaLista">
                            <StackPanel Spacing="1" Margin="0,2">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Situacao}" FontSize="11" Opacity="0.8"
                                               Foreground="{DynamicResource TextoDeAviso}" IsVisible="{Binding Vencida}" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Situacao}" FontSize="11" Opacity="0.8" IsVisible="{Binding !Vencida}" />
                                    <TextBlock Text="{Binding Codigo}" FontWeight="SemiBold" />
                                </DockPanel>
                                <TextBlock Text="{Binding Titulo}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Titulo}" />
                                <TextBlock Text="{Binding Detalhe}" FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Panel>
        </DockPanel>

        <!-- A ficha -->
        <Panel>
            <TextBlock Text="Escolha uma OS na lista, ou crie uma." Opacity="0.6" IsVisible="{Binding !TemSelecionada}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            <DockPanel IsVisible="{Binding TemSelecionada}">
                <!-- Cabeçalho e o fluxo -->
                <StackPanel DockPanel.Dock="Top" Spacing="6">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                            <!-- Bloco 59 -->
                            <CheckBox Content="com os valores" IsChecked="{Binding ValoresNoTelegram}" IsVisible="{Binding PodeMandarAoTelegram}"
                                      ToolTip.Tip="A mensagem no grupo mostra os preços e o total (todos do grupo veem)" />
                            <Button x:Name="MandarAoTelegram" Content="Mandar ao grupo do Telegram" Command="{Binding MandarAoTelegramCommand}"
                                    IsVisible="{Binding PodeMandarAoTelegram}"
                                    ToolTip.Tip="A OS vai ao grupo da obra com os botões Aceitar, Comecei e Terminei; as mudanças seguintes vão junto" />
                            <Button x:Name="SalvarPdf" Content="Salvar PDF…" Command="{Binding SalvarPdfCommand}" />
                            <Button x:Name="Imprimir" Content="Imprimir…" Command="{Binding ImprimirCommand}"
                                    ToolTip.Tip="Abre o PDF da OS no leitor do sistema, para imprimir e assinar" />
                        </StackPanel>
                        <TextBlock x:Name="Cabecalho" Text="{Binding Cabecalho}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{Binding AvisoDeVencida}" Foreground="{DynamicResource TextoDeAviso}"
                               IsVisible="{Binding AvisoDeVencida, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <WrapPanel ItemSpacing="6" LineSpacing="6">
                        <Button x:Name="Salvar" Content="Salvar" Command="{Binding SalvarCommand}" IsVisible="{Binding PodeEditar}" />
                        <Button x:Name="Emitir" Classes="accent" Content="Emitir" Command="{Binding EmitirCommand}" IsVisible="{Binding PodeEmitir}"
                                ToolTip.Tip="A OS sai do rascunho e vai para o executante (no PDF ou pelo Telegram)" />
                        <Button x:Name="Aceitar" Content="Aceita pelo executante" Command="{Binding AceitarCommand}" IsVisible="{Binding PodeAceitar}" />
                        <Button x:Name="Recusar" Content="Recusada…" Command="{Binding RecusarCommand}" IsVisible="{Binding PodeAceitar}" />
                        <Button x:Name="Iniciar" Content="Iniciar execução" Command="{Binding IniciarCommand}" IsVisible="{Binding PodeIniciar}" />
                        <Button x:Name="Concluir" Content="Concluída" Command="{Binding ConcluirCommand}" IsVisible="{Binding PodeConcluir}"
                                ToolTip.Tip="O executante terminou: falta a conferência" />
                        <Button x:Name="Conferir" Classes="accent" Content="Conferir e aprovar" Command="{Binding ConferirCommand}" IsVisible="{Binding PodeConferir}" />
                        <Button x:Name="Reprovar" Content="Reprovar…" Command="{Binding ReprovarCommand}" IsVisible="{Binding PodeConferir}"
                                ToolTip.Tip="Precisa refazer: volta à execução, com o motivo no histórico" />
                        <Button x:Name="VoltarARascunho" Content="Voltar a rascunho" Command="{Binding VoltarARascunhoCommand}" IsVisible="{Binding PodeVoltarARascunho}" />
                        <Button x:Name="Cancelar" Content="Cancelar OS…" Command="{Binding CancelarCommand}" IsVisible="{Binding PodeCancelar}" />
                        <Button x:Name="ExcluirRascunho" Content="Excluir rascunho" Command="{Binding ExcluirRascunhoCommand}" IsVisible="{Binding PodeEditar}" />
                        <Button x:Name="Duplicar" Content="Duplicar" Command="{Binding DuplicarCommand}"
                                ToolTip.Tip="Uma OS nova em rascunho com os mesmos dados (um serviço que se repete)" />
                    </WrapPanel>
                </StackPanel>

                <ScrollViewer Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="6" Margin="0,0,12,0">
                        <!-- Os dados -->
                        <Grid ColumnDefinitions="110,*,14,110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" IsEnabled="{Binding PodeEditar}">
                            <Grid.Styles>
                                <Style Selector="Grid > Control">
                                    <Setter Property="Margin" Value="0,3" />
                                </Style>
                            </Grid.Styles>
                            <TextBlock Classes="rotulo" Text="Serviço" />
                            <TextBox Grid.Column="1" Grid.ColumnSpan="4" x:Name="TituloDaOrdem" Text="{Binding TituloDaOrdem}"
                                     PlaceholderText="Ex.: Alvenaria do 1º pavimento" />
                            <TextBlock Grid.Row="1" Classes="rotulo" Text="Executante" />
                            <AutoCompleteBox Grid.Row="1" Grid.Column="1" x:Name="Executante" Text="{Binding Executante}" ItemsSource="{Binding Sugestoes}"
                                             FilterMode="ContainsOrdinal" PlaceholderText="Equipe ou empreiteiro" />
                            <TextBlock Grid.Row="1" Grid.Column="3" Classes="rotulo" Text="Tipo" />
                            <ComboBox Grid.Row="1" Grid.Column="4" ItemsSource="{Binding Tipos}" SelectedItem="{Binding TipoEscolhido}" HorizontalAlignment="Stretch" />
                            <TextBlock Grid.Row="2" Classes="rotulo" Text="Contato" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Contato}" PlaceholderText="Telefone ou e-mail" />
                            <TextBlock Grid.Row="2" Grid.Column="3" Classes="rotulo" Text="Pagamento" />
                            <ComboBox Grid.Row="2" Grid.Column="4" ItemsSource="{Binding Formas}" SelectedItem="{Binding FormaEscolhida}" HorizontalAlignment="Stretch" />
                            <TextBlock Grid.Row="3" Classes="rotulo" Text="Início previsto" />
                            <CalendarDatePicker Grid.Row="3" Grid.Column="1" SelectedDate="{Binding InicioPrevisto}" HorizontalAlignment="Stretch" />
                            <TextBlock Grid.Row="3" Grid.Column="3" Classes="rotulo" Text="Prazo" />
                            <CalendarDatePicker Grid.Row="3" Grid.Column="4" SelectedDate="{Binding Prazo}" HorizontalAlignment="Stretch" />
                            <!-- Bloco 62 -->
                            <TextBlock Grid.Row="4" Classes="rotulo" Text="Retenção (%)" />
                            <TextBox Grid.Row="4" Grid.Column="1" x:Name="Retencao" Text="{Binding Retencao}" PlaceholderText="0 (sem retenção de garantia)"
                                     ToolTip.Tip="A retenção de garantia: o % de cada pagamento que fica retido até a liberação, depois da conferência (5% é o comum)" />
                            <TextBlock Grid.Row="5" Classes="rotulo" Text="Observações" VerticalAlignment="Top" Margin="0,8,0,0" />
                            <TextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="4" Text="{Binding Observacoes}" AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="56" PlaceholderText="Segurança, EPIs, material fornecido pela obra, horário…" />
                        </Grid>

                        <!-- Os itens -->
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding TotalDaFicha, StringFormat='Total: {0}'}" FontWeight="SemiBold" VerticalAlignment="Bottom" />
                            <TextBlock Classes="secao" Text="Itens" />
                        </DockPanel>
                        <Grid ColumnDefinitions="50,*,60,90,100,100,30">
                            <TextBlock Classes="cabecalhoDosItens" Text="Tarefa" />
                            <TextBlock Grid.Column="1" Classes="cabecalhoDosItens" Text="Descrição" />
                            <TextBlock Grid.Column="2" Classes="cabecalhoDosItens" Text="Un" />
                            <TextBlock Grid.Column="3" Classes="cabecalhoDosItens" Text="Quantidade" />
                            <TextBlock Grid.Column="4" Classes="cabecalhoDosItens" Text="Preço un. (R$)" />
                            <TextBlock Grid.Column="5" Classes="cabecalhoDosItens" Text="Total (R$)" TextAlignment="Right" />
                        </Grid>
                        <ItemsControl x:Name="Itens" ItemsSource="{Binding Itens}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ItemNaFicha">
                                    <Grid ColumnDefinitions="50,*,60,90,100,100,30" Margin="0,2">
                                        <TextBlock Text="{Binding Tarefa}" VerticalAlignment="Center" FontSize="12" />
                                        <TextBox Grid.Column="1" Text="{Binding Descricao}" Margin="0,0,4,0"
                                                 IsEnabled="{Binding $parent[ItemsControl].((vm:OrdensDeServicoViewModel)DataContext).PodeEditar}" />
                                        <TextBox Grid.Column="2" Text="{Binding Unidade}" Margin="0,0,4,0"
                                                 IsEnabled="{Binding $parent[ItemsControl].((vm:OrdensDeServicoViewModel)DataContext).PodeEditar}" />
                                        <TextBox Grid.Column="3" Text="{Binding Quantidade}" Margin="0,0,4,0" TextAlignment="Right"
                                                 IsEnabled="{Binding $parent[ItemsControl].((vm:OrdensDeServicoViewModel)DataContext).PodeEditar}" />
                                        <TextBox Grid.Column="4" Text="{Binding Preco}" Margin="0,0,4,0" TextAlignment="Right"
                                                 IsEnabled="{Binding $parent[ItemsControl].((vm:OrdensDeServicoViewModel)DataContext).PodeEditar}" />
                                        <TextBlock Grid.Column="5" Text="{Binding Total}" VerticalAlignment="Center" TextAlignment="Right" />
                                        <Button Grid.Column="6" Content="✕" Padding="6,2" HorizontalAlignment="Right" ToolTip.Tip="Tirar o item"
                                                Command="{Binding $parent[ItemsControl].((vm:OrdensDeServicoViewModel)DataContext).RemoverItemCommand}" CommandParameter="{Binding}"
                                                IsVisible="{Binding $parent[ItemsControl].((vm:OrdensDeServicoViewModel)DataContext).PodeEditar}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <WrapPanel ItemSpacing="6" LineSpacing="6" IsVisible="{Binding PodeEditar}">
                            <Button x:Name="AdicionarItem" Content="Adicionar item" Command="{Binding AdicionarItemCommand}" />
                            <Button x:Name="TrazerItens" Content="Trazer itens das tarefas marcadas" Command="{Binding TrazerItensDasTarefasCommand}" />
                            <ComboBox ItemsSource="{Binding Precos}" SelectedItem="{Binding PrecoEscolhido}" MinWidth="260"
                                      ToolTip.Tip="O preço que vem da composição do orçamento (sem BDI: é o que se paga ao executante)" />
                        </WrapPanel>

                        <!-- Bloco 60: medições e pagamentos -->
                        <StackPanel Spacing="4" IsVisible="{Binding MostraMedicoes}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" x:Name="ResumoDasMedicoes" Text="{Binding ResumoDasMedicoes}" FontSize="12" VerticalAlignment="Bottom" />
                                <TextBlock Classes="secao" Text="Medições e pagamentos" />
                            </DockPanel>
                            <ItemsControl x:Name="Medicoes" ItemsSource="{Binding MedicoesNaTela}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MedicaoNaTela">
                                        <DockPanel Margin="0,2">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                                                <!-- Bloco 65 -->
                                                <Button Content="Boletim PDF…"
                                                        Command="{Binding $parent[ItemsControl].((vm:OrdensDeServicoViewModel)DataContext).BoletimPdfCommand}" CommandParameter="{Binding}"
                                                        ToolTip.Tip="O boletim de medição desta medição, para pagar o executante: anterior, nesta, acumulado, retenção e líquido" />
                                                <Button Content="Excel…"
                                                        Command="{Binding $parent[ItemsControl].((vm:OrdensDeServicoViewModel)DataContext).BoletimExcelCommand}" CommandParameter="{Binding}" />
                                                <Button Content="Pagar…" IsVisible="{Binding !Paga}"
                                                        Command="{Binding $parent[ItemsControl].((vm:OrdensDeServicoViewModel)DataContext).PagarMedicaoCommand}" CommandParameter="{Binding}"
                                                        ToolTip.Tip="Registra o pagamento e lança o valor nos custos realizados (por tarefa)" />
                                                <Button Content="Tirar" IsVisible="{Binding !Paga}"
                                                        Command="{Binding $parent[ItemsControl].((vm:OrdensDeServicoViewModel)DataContext).RemoverMedicaoCommand}" CommandParameter="{Binding}" />
                                                <Button Content="Desfazer pagamento" IsVisible="{Binding Paga}"
                                                        Command="{Binding $parent[ItemsControl].((vm:OrdensDeServicoViewModel)DataContext).DesfazerPagamentoCommand}" CommandParameter="{Binding}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Texto}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Situacao}" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12" Opacity="0.75" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- Bloco 62: a retenção de garantia -->
                            <DockPanel IsVisible="{Binding TextoDaLiberacao, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <Button DockPanel.Dock="Right" Content="Desfazer liberação" Command="{Binding DesfazerLiberacaoCommand}" IsVisible="{Binding RetencaoLiberada}" />
                                <Button x:Name="LiberarRetencao" Classes="accent" Content="{Binding TextoDaLiberacao}" Command="{Binding LiberarRetencaoCommand}"
                                        IsVisible="{Binding PodeLiberarRetencao}"
                                        ToolTip.Tip="Paga ao executante o que ficou retido (lança nos custos realizados) e a OS fica paga" />
                                <TextBlock Text="{Binding TextoDaLiberacao}" IsVisible="{Binding RetencaoLiberada}" VerticalAlignment="Center" FontSize="12" />
                            </DockPanel>
                            <Border Background="{DynamicResource FundoDosFiltros}" CornerRadius="6" Padding="10" Margin="0,4,0,0" IsVisible="{Binding PodeMedir}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Nova medição: quanto foi executado de cada item desde a última" FontSize="12" FontWeight="SemiBold" />
                                    <Grid ColumnDefinitions="*,110,110,120">
                                        <TextBlock Classes="cabecalhoDosItens" Text="Item" />
                                        <TextBlock Grid.Column="1" Classes="cabecalhoDosItens" Text="Contratado" TextAlignment="Right" />
                                        <TextBlock Grid.Column="2" Classes="cabecalhoDosItens" Text="Já medido" TextAlignment="Right" />
                                        <TextBlock Grid.Column="3" Classes="cabecalhoDosItens" Text="Nesta medição" TextAlignment="Right" />
                                    </Grid>
                                    <ItemsControl x:Name="ItensParaMedir" ItemsSource="{Binding ItensParaMedir}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ItemParaMedir">
                                                <Grid ColumnDefinitions="*,110,110,120" Margin="0,2">
                                                    <TextBlock Text="{Binding Descricao}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Contratado}" VerticalAlignment="Center" TextAlignment="Right" FontSize="12" />
                                                    <TextBlock Grid.Column="2" Text="{Binding JaMedido}" VerticalAlignment="Center" TextAlignment="Right" FontSize="12" />
                                                    <TextBox Grid.Column="3" Text="{Binding NestaMedicao}" TextAlignment="Right" Margin="8,0,0,0" PlaceholderText="0" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <WrapPanel ItemSpacing="8" LineSpacing="6">
                                        <CalendarDatePicker SelectedDate="{Binding DataDaMedicao}" Width="150" />
                                        <CheckBox Content="Atualizar o % concluído das tarefas" IsChecked="{Binding AtualizarTarefas}" />
                                        <Button Content="Tudo o que falta" Command="{Binding MedirTudoOQueFaltaCommand}" />
                                        <Button x:Name="RegistrarMedicao" Classes="accent" Content="Registrar medição" Command="{Binding RegistrarMedicaoCommand}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- As tarefas -->
                        <Expander Header="Tarefas da OS" Margin="0,8,0,0" HorizontalAlignment="Stretch">
                            <ScrollViewer MaxHeight="220">
                                <ItemsControl ItemsSource="{Binding Tarefas}" IsEnabled="{Binding PodeEditar}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TarefaParaEscolher">
                                            <CheckBox Content="{Binding Texto}" IsChecked="{Binding Marcada}" Margin="{Binding Recuo}" FontWeight="Normal" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Expander>

                        <!-- A verificação -->
                        <TextBlock Classes="secao" Text="Lista de verificação" IsVisible="{Binding MostraVerificacao}" />
                        <ItemsControl x:Name="Verificacao" ItemsSource="{Binding Verificacao}" IsEnabled="{Binding PodeMarcarVerificacao}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:VerificacaoNaFicha">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="✕" Padding="6,2" ToolTip.Tip="Tirar da lista"
                                                Command="{Binding $parent[ItemsControl].((vm:OrdensDeServicoViewModel)DataContext).RemoverVerificacaoCommand}" CommandParameter="{Binding}"
                                                IsVisible="{Binding $parent[ItemsControl].((vm:OrdensDeServicoViewModel)DataContext).PodeEditar}" />
                                        <CheckBox Content="{Binding Texto}" IsChecked="{Binding Feito}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <DockPanel IsVisible="{Binding PodeEditar}">
                            <Button DockPanel.Dock="Right" Content="Adicionar" Command="{Binding AdicionarVerificacaoCommand}" Margin="6,0,0,0" />
                            <TextBox x:Name="NovaVerificacao" Text="{Binding NovaVerificacao}" PlaceholderText="Ex.: limpeza feita, teste de estanqueidade" />
                        </DockPanel>

                        <!-- O histórico -->
                        <TextBlock Classes="secao" Text="Histórico" />
                        <ItemsControl x:Name="Historico" ItemsSource="{Binding Historico}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{Binding}" FontSize="12" Opacity="0.8" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Panel>
    </DockPanel>
</Window>
