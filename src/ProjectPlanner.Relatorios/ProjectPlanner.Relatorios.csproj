<Project Sdk="Microsoft.NET.Sdk">

  <!-- Bloco 27: o relatório fotográfico em PDF (SkiaSharp, MIT, a mesma versão que o Avalonia já usa e publica) e em
       Word (DocumentFormat.OpenXml, MIT, da Microsoft). Só desenha: o que entra e em que ordem vem pronto do Core
       (MontadorDoRelatorio). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProjectPlanner.Core\ProjectPlanner.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ProjectPlanner.Relatorios.Tests" />
  </ItemGroup>

</Project>
