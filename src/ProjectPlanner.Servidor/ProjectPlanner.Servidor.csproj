<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Bloco 44: o servidor de contas e IA (ver docs/SERVIDOR.md). A chave do Gemini fica só aqui (configuração do
       servidor); o app manda os pedidos de IA com o token do usuário. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ProjectPlanner.Servidor</RootNamespace>
    <!-- 0.55.2: o servidor roda com 512 MB (Render): o coletor de estação de trabalho usa bem menos memória que o de servidor, e
         ConserveMemory compacta a área dos objetos grandes (os anexos em base64), que antes só crescia. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <PackageReference Include="Google.Apis.Auth" Version="1.69.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ProjectPlanner.Servidor.Tests" />
  </ItemGroup>

  <!-- Bloco 49: o assistente do Telegram usa o mesmo assistente do programa (retrato, instruções e formato das atualizações) -->
  <ItemGroup>
    <ProjectReference Include="..\ProjectPlanner.IA\ProjectPlanner.IA.csproj" />
  </ItemGroup>

  <!-- Bloco 48: a página do painel financeiro, embutida (a imagem Docker leva só a dll) -->
  <ItemGroup>
    <EmbeddedResource Include="Painel\painel.html" LogicalName="ProjectPlanner.Servidor.Painel.painel.html" />
    <EmbeddedResource Include="Painel\painel.js" LogicalName="ProjectPlanner.Servidor.Painel.painel.js" />
  </ItemGroup>

</Project>
