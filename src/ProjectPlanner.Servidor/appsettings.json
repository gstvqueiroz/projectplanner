{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Banco": "Data Source=servidor.db"
  },
  "Jwt": {
    "MinutosDeAcesso": 15,
    "DiasDeRenovacao": 30
  },
  "Gemini": {
    "Modelos": [ "gemini-2.5-flash", "gemini-2.5-flash-lite", "gemini-2.5-pro" ]
  },
  "Planos": {
    "GratisTokensPorMes": 300000,
    "ProfissionalTokensPorMes": 10000000
  },
  "Limites": {
    "PedidosDeIaPorMinuto": 30,
    "PedidosDeContaPorMinuto": 10,
    "MegabytesPorPedido": 15,
    "TentativasAteBloquear": 5,
    "MinutosDeBloqueio": 15,
    "AtrasDeProxy": false
  }
}
